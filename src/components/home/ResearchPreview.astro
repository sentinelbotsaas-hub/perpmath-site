---
// The backtests, in short: how many were run, over what data, at what cost,
// and what each one did out of sample. Losing results are shown exactly like
// any other; that is the point of the section. A grid result that gained is
// shown with the condition it gained under, in the place where a signal
// strategy has its verdict.
//
// Every figure is read from src/data/backtests/*.json through
// src/lib/backtests/load.ts, with the formatters and the verdict rule that
// /backtests/ uses, and the headline is the one /backtests/ prints
// (src/components/research/headline.ts). Nothing is averaged or summed
// across strategies here. A fact that is not the same in every result file
// (the data period, the costs, the out-of-sample range, the market) is left
// out instead of guessed.
//
// The list is one line a result: its name, its out-of-sample total return,
// the verdict of that sample and how many trades the verdict rests on. The
// other figures (win rate, average R, t, drawdown) are on /backtests/. With
// seven results a block of four figures each made the home page a report.
// A sample with too few trades says so here in words and with a warning
// icon, and nothing of it but its total return is printed.
import { gridViews } from '../research/grid-views';
import { headline } from '../research/headline';
import Icon from '../ui/Icon.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { backtests } from '../../i18n/backtests';
import { localePath } from '../../i18n/config';
import type { Locale } from '../../i18n/config';
import { home } from '../../i18n/home';
import { formatCount, formatDay, formatPct, formatRate } from '../../lib/backtests/format';
import { allResults, backtestPath, gridResults, results } from '../../lib/backtests/load';
import { verdictOf } from '../../lib/backtests/verdict';
import { fmt } from '../../lib/fmt';
import { pageExists } from '../../lib/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = home[locale].research;
const bt = backtests[locale];
const x = bt.index;

if (results.length === 0) throw new Error('home: src/data/backtests/ is empty. Run scripts/backtests-import.mjs.');

// Same headline as /backtests/, so the two can never disagree.
const top = headline(x, bt.na);
const head = top.head;
const na = bt.na;
const hasGrid = gridResults.length > 0;

/** The value all of `list` share, or null when they differ. */
function shared<R, T>(list: R[], pick: (result: R) => T): T | null {
  const first = pick(list[0]);
  return list.every((result) => pick(result) === first) ? first : null;
}

// The period and the split are facts about every result, the grid included.
// The fee and the slippage are the signal strategies' own: a grid pays a
// maker fee on its grid orders, so the label says whose costs these are.
const firstBar = shared(allResults, (r) => r.data.first_bar);
const lastBar = shared(allResults, (r) => r.data.last_bar);
const fee = shared(results, (r) => r.costs.fee_rate_per_side);
const slip = shared(results, (r) => r.costs.slippage_per_fill);
const oosFirst = shared(allResults, (r) => r.out_of_sample.first_bar);
const oosLast = shared(allResults, (r) => r.out_of_sample.last_bar);

const facts = [
  firstBar && lastBar
    ? { label: t.period, value: fmt(bt.range, { from: formatDay(firstBar), to: formatDay(lastBar) }) }
    : null,
  oosFirst && oosLast
    ? { label: t.oosFrom, value: formatDay(oosFirst) }
    : null,
  fee !== null && slip !== null
    ? { label: hasGrid ? t.costsStrategies : t.costs, value: fmt(t.costsValue, { fee: formatRate(fee), slip: formatRate(slip) }) }
    : null,
].filter((fact) => fact !== null);

// x.sub already says fees and slippage are on every fill; only the funding half of the caption is added.
const method = [x.sub, top.fundingNote].filter(Boolean).join(locale === 'en' ? ' ' : '');

// The market is printed once, beside the list's heading, when every result
// shares it; otherwise on each line.
const market = shared(allResults, (r) => `${r.symbol} ${r.interval}`);

interface Row {
  name: string;
  href: string;
  market: string;
  /** Out-of-sample total return as printed, and its sign for the colour. */
  ret: string;
  sign: -1 | 0 | 1;
  /** The verdict of the sample, or for a grid what the sample depended on. */
  reading: string;
  /** True when the sample has too few trades to read. */
  thin: boolean;
  countLabel: string;
  count: string;
}

const strategyRows: Row[] = results.map((result) => {
  const strategy = bt.strategies[result.strategy as keyof typeof bt.strategies];
  if (!strategy) throw new Error(`home: no strings for strategy "${result.strategy}" in src/i18n/backtests.ts`);
  const m = result.out_of_sample.metrics;
  const r = m.total_return_pct;
  const verdict = verdictOf(m);
  return {
    name: strategy.short,
    href: localePath(locale, backtestPath(result.slug)),
    market: `${result.symbol} ${result.interval}`,
    ret: formatPct(r) ?? na,
    sign: r === null || r === 0 ? 0 : r < 0 ? -1 : 1,
    reading: bt.verdict[verdict],
    thin: verdict === 'insufficient',
    countLabel: bt.columns.trades,
    count: formatCount(m.trades),
  };
});
// A grid has no trades with a stop, so no verdict: its line ends with what
// the sample depended on, and counts round trips.
const gridRows: Row[] = gridResults.map((result) => {
  const view = gridViews(result, bt)[1];
  return {
    name: bt.grid.short,
    href: localePath(locale, backtestPath(result.slug)),
    market: `${result.symbol} ${result.interval}`,
    ret: view.totalReturn,
    sign: view.totalReturnSign,
    reading: view.noteShort,
    thin: false,
    countLabel: bt.grid.compare.roundTrips,
    count: view.roundTrips,
  };
});
const rows = [...strategyRows, ...gridRows];
---

<SectionHeader title={head} desc={t.sub} id="research-head" />

<div class="rs">
  <div class="rs-about">
    <p class="rs-method">{method}</p>
    <dl class="rs-facts">
      {
        facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="acts rs-acts">
    <a class="btn secondary" href={localePath(locale, '/backtests/')}>{t.results}</a>
    {
      pageExists('/bot/') && (
        <a class="lnk" href={localePath(locale, '/bot/')}>
          {t.code}
          <Icon name="arrow-right" size={16} />
        </a>
      )
    }
  </div>

  <div class="rs-results">
    <div class="rs-results-head">
      <h3 class="rs-sample">{bt.detail.result.totalReturn.out_of_sample}</h3>
      {market && <p class="num rs-market">{market}</p>}
    </div>
    <ul class="rs-rows" aria-label={t.listLabel}>
      {
        rows.map((row) => (
          <li>
            <a class="lnk rs-name" href={row.href}>
              {row.name}
            </a>
            <p class="rs-meta">
              <span class="rs-reading" data-tone={row.thin ? 'warning' : undefined}>
                {row.thin && <Icon name="triangle-alert" size={14} />}
                {row.reading}
              </span>
              <span class="rs-count">
                {row.countLabel} <span class="num">{row.count}</span>
              </span>
              {!market && <span class="num rs-count">{row.market}</span>}
            </p>
            <p class:list={['num', 'rs-return', { 'rs-neg': row.sign < 0, 'rs-pos': row.sign > 0 }]}>
              <span class="visually-hidden">{bt.columns.totalReturn}</span>
              {row.ret}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  /* A phone reads top to bottom: the method, the results, then where to go.
     Side by side, the actions sit under the method. */
  .rs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "about" "results" "acts";
    gap: var(--space-8);
    align-items: start;
  }

  .rs-about {
    grid-area: about;
  }

  .rs-results {
    grid-area: results;
  }

  .rs-acts {
    grid-area: acts;
    margin-top: 0;
  }

  .rs-method {
    max-width: 60ch;
    color: var(--color-text-secondary);
  }

  .rs-facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-top: var(--space-6);
    border-top: var(--hairline) solid var(--color-border);
  }

  .rs-facts > div {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-6);
    padding-block: var(--space-3);
    border-bottom: var(--hairline) solid var(--color-border);
  }

  .rs-facts dt {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  .rs-facts dd {
    font-variant-numeric: tabular-nums;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .rs-sample {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0;
  }

  .rs-rows {
    margin-top: var(--space-3);
    border-top: var(--hairline) solid var(--color-border-hover);
  }

  /* What the column of figures is, and the market they share. */
  .rs-results-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
  }

  .rs-market {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  /* One result a line. On a phone the name and the return share the first
     line and the verdict sits under them; from 620px it is one row. */
  .rs-rows li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "name ret" "meta meta";
    align-items: center;
    gap: 0 var(--space-4);
    padding-block: var(--space-1) var(--space-3);
    border-bottom: var(--hairline) solid var(--color-border);
  }

  .rs-name {
    grid-area: name;
    justify-self: start;
    font-weight: var(--weight-strong);
    white-space: normal;
  }

  .rs-return {
    grid-area: ret;
    font-size: var(--text-card);
    font-weight: var(--weight-medium);
    text-align: right;
  }

  .rs-meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  /* "Too few trades": the icon and the words say it, the colour repeats it. */
  .rs-reading[data-tone] {
    color: var(--tone);
  }

  .rs-reading :global(.icon) {
    margin-right: var(--space-1);
    vertical-align: -0.12em;
  }

  .rs-count {
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* The sign is in the text; the colour repeats it. */
  .rs-neg {
    color: var(--color-negative);
  }

  .rs-pos {
    color: var(--color-positive);
  }

  @media (min-width: 620px) {
    .rs-rows li {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.5fr) minmax(8ch, auto);
      grid-template-areas: "name meta ret";
      padding-block: var(--space-1);
    }
  }

  @media (min-width: 960px) {
    .rs {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr);
      grid-template-areas: "about results" "acts results";
      grid-template-rows: auto 1fr;
      gap: var(--space-6) var(--space-16);
    }
  }
</style>
