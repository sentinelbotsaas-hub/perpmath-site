---
// The home hero's right column: a liquidation risk simulator.
//
// One example position (a BTCUSDT long), one control (leverage), one figure
// (the liquidation price) and the risk ruler, which is the picture this site
// is remembered by. The numbers come from src/lib/calc/liquidation.ts and the
// Bybit risk-limit snapshot; the same ones are recomputed in the browser by
// src/scripts/home-hero.ts when the leverage moves.
//
// Without JavaScript the panel shows the complete result at START_LEVERAGE
// and says the leverage is fixed; the slider and the number box are hidden.
import DataFreshness from '../ui/DataFreshness.astro';
import Icon from '../ui/Icon.astro';
import RiskRuler from '../ui/RiskRuler.astro';
import { layoutRiskRuler } from '../ui/risk-ruler';
import { common } from '../../i18n/common';
import { localePath } from '../../i18n/config';
import type { Locale } from '../../i18n/config';
import { home } from '../../i18n/home';
import { liquidationPrice, roundToTick } from '../../lib/calc/liquidation';
import { fmt, formatNumber, formatPercent, tickDecimals } from '../../lib/fmt';
import { BTCUSDT, snapshotDate, tierOne } from '../../lib/risk-limit';
import { toolPath } from '../../lib/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = home[locale].sim;

// The example. The entry price is an illustration (the panel says so); the
// maintenance margin rate and the tick size are Bybit's, from the snapshot.
const ENTRY = 68000;
const START_LEVERAGE = 20;
const MIN_LEVERAGE = 2;
const MAX_LEVERAGE = 100;
const mmr = tierOne(BTCUSDT).maintenanceMargin;
const tick = BTCUSDT.tickSize;
const decimals = tickDecimals(tick);

const result = liquidationPrice({ side: 'long', entryPrice: ENTRY, leverage: START_LEVERAGE, mmr });
if (!result.ok) throw new Error('home: the hero example is not a valid position');
const liq = roundToTick(result.liquidationPrice, tick);

// The ruler's own layout gives the distance, so the sentence and the ruler
// can never print two different percentages.
const layout = layoutRiskRuler({ entry: ENTRY, liquidation: liq, side: 'long' }, common[locale].ruler, { decimals });
const pct = formatPercent(layout.distance);
const lev = (n: number) => fmt(t.levFormat, { n });
const calculatorHref = localePath(locale, toolPath('liquidation-price-calculator'));

// Everything the browser script needs, as plain data.
// The sentence is printed around its percentage, so the figure alone can
// take the "down" colour. The words and their order are the string's own.
const [sentenceBefore = '', sentenceAfter = ''] = t.sentence.split('{pct}');

const heroData = JSON.stringify({
  entry: ENTRY,
  mmr,
  tick,
  decimals,
  min: MIN_LEVERAGE,
  max: MAX_LEVERAGE,
  calculatorHref,
  strings: { levFormat: t.levFormat, sliderText: t.sliderText, sentence: t.sentence },
});
---

<div class="sim" data-hero={heroData}>
  <div class="sim-head">
    <h2 class="sim-title">{t.title}</h2>
    <span class="tag">{t.example}</span>
  </div>

  <div class="sim-inputs">
    <div class="sim-entry">
      <p class="field-label">{t.entry}</p>
      <p class="sim-entry-value"><span class="num">{formatNumber(ENTRY)}</span> USDT</p>
    </div>

    <div class="sim-lev">
      <label class="field-label" for="hero-lev">{t.leverage}</label>
      <div class="sim-controls">
        <div class="sim-range">
          <input
            class="slider"
            id="hero-lev"
            type="range"
            min={MIN_LEVERAGE}
            max={MAX_LEVERAGE}
            step="1"
            value={START_LEVERAGE}
            aria-valuetext={fmt(t.sliderText, { lev: lev(START_LEVERAGE), pct })}
          />
          <div class="sim-range-ends" aria-hidden="true">
            <span class="num">{MIN_LEVERAGE}</span>
            <span class="num">{MAX_LEVERAGE}</span>
          </div>
        </div>
        <span class="field-box">
          <input
            id="hero-lev-n"
            type="text"
            inputmode="numeric"
            autocomplete="off"
            value={START_LEVERAGE}
            aria-label={t.leverageNumber}
          />
          <span aria-hidden="true">{t.levUnit}</span>
        </span>
      </div>
      <p class="sim-fixed">{fmt(t.fixed, { lev: lev(START_LEVERAGE) })}</p>
    </div>
  </div>

  <div class="sim-result">
    <div aria-live="polite" aria-atomic="true">
      <p class="result-label">{t.liqLabel}</p>
      <p class="sim-figure">
        <span class="num" id="hero-liq">{formatNumber(liq, decimals)}</span>
        <span class="sim-unit">USDT</span>
      </p>
    </div>
    <p class="sim-sentence" id="hero-sentence">{sentenceBefore}<span class="toned" data-tone="negative" id="hero-pct">{pct}</span>{sentenceAfter}</p>
  </div>

  <RiskRuler
    locale={locale}
    id="hero-ruler"
    size="l"
    side="long"
    entry={ENTRY}
    liquidation={liq}
    decimals={decimals}
    entryDecimals={0}
    caption="sr"
  />

  <div class="sim-foot">
    <p class="sim-assume">{fmt(t.assumptions, { mmr: formatPercent(mmr) })}</p>
    <DataFreshness locale={locale} date={snapshotDate(BTCUSDT)} source={t.source} />
    <a class="lnk" id="hero-open" href={`${calculatorHref}?lev=${START_LEVERAGE}`}>
      {t.link}
      <Icon name="arrow-right" size={16} />
    </a>
  </div>
</div>

<style>
  .sim {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    min-width: 0;
    padding: var(--card-pad);
    background: var(--color-surface);
    border: var(--hairline) solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .sim-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }

  .sim-title {
    font-size: var(--text-card);
    line-height: var(--leading-tight);
    letter-spacing: 0;
  }

  /* Entry price (fixed) beside the leverage control. */
  .sim-inputs {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4) var(--space-8);
    align-items: start;
  }

  .sim-entry,
  .sim-lev {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
    min-width: 0;
  }

  .sim-entry-value {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-h);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .sim-entry-value .num {
    color: var(--color-text);
    font-size: var(--text-card);
    font-weight: var(--weight-medium);
  }

  .sim-controls {
    display: flex;
    align-items: start;
    gap: var(--space-4);
  }

  .sim-range {
    flex: 1 1 auto;
    min-width: 0;
  }

  .sim-range .slider {
    display: block;
    width: 100%;
    min-height: var(--control-h);
  }

  /* The two ends of the slider, under it. */
  .sim-range-ends {
    display: flex;
    justify-content: space-between;
    margin-top: calc(var(--space-2) * -1);
    color: var(--color-text-muted);
    font-size: var(--text-2xs);
    line-height: 1.4;
  }

  .sim-controls .field-box {
    flex: none;
    width: calc(var(--space-24) + var(--space-2));
  }

  /* Script off: no slider that does nothing, one line that says so. */
  .sim-fixed {
    display: none;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  :global(html:not([data-js])) .sim-controls {
    display: none;
  }

  :global(html:not([data-js])) .sim-fixed {
    display: block;
  }

  .sim-result {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
    padding-top: var(--space-6);
    border-top: var(--hairline) solid var(--color-border);
  }

  .sim-figure {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-3);
    margin-top: var(--space-1);
    font-size: var(--text-page);
    font-weight: var(--weight-medium);
    line-height: var(--leading-figure);
    letter-spacing: -0.02em;
  }

  .sim-unit {
    color: var(--color-text-muted);
    font-size: var(--text-md);
    font-weight: var(--weight-regular);
    letter-spacing: 0;
  }

  .sim-sentence {
    color: var(--color-text-secondary);
  }

  /* The ruler is what the hero is for: a taller track than the component's
     own large size. Only its height variable is set; the marks stay where
     updateRiskRuler() puts them. */
  .sim :global(.rr.l) {
    --rr-track-h: calc(var(--space-12) + var(--space-2));
  }

  .sim-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
    gap: var(--space-2);
    padding-top: var(--space-5);
    border-top: var(--hairline) solid var(--color-border);
  }

  .sim-assume {
    max-width: 68ch;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  @media (min-width: 1200px) {
    .sim {
      padding: var(--space-8);
    }
  }

  /* A phone: the entry price becomes one line above the leverage control. */
  @media (max-width: 520px) {
    .sim-inputs {
      grid-template-columns: minmax(0, 1fr);
    }

    .sim-entry {
      grid-template-columns: auto auto;
      justify-content: space-between;
      align-items: baseline;
    }

    .sim-entry-value {
      min-height: 0;
    }

    .sim-controls {
      gap: var(--space-3);
    }
  }
</style>
