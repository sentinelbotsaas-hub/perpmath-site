---
// The table of contents of an article, built from its <h2> headings.
//
//   <ArticleToc title={t.toc} headings={headings} variant="side" />   desktop: a sticky list beside the text
//   <ArticleToc title={t.toc} headings={headings} variant="fold" />   phone: a <details> above the text
//
// The page renders both and shows one of them by viewport width. Both are
// plain links to the headings' ids: they work with scripting off, and the
// folded one is a native <details>.
import Accordion from '../ui/Accordion.astro';

interface Props {
  title: string;
  /** From `render(entry).headings`, already filtered to the level to list. */
  headings: Array<{ slug: string; text: string }>;
  variant: 'side' | 'fold';
}

const { title, headings, variant } = Astro.props;
---

{
  headings.length > 0 &&
    (variant === 'side' ? (
      <nav class="art-toc" aria-label={title}>
        <p class="art-toc-title">{title}</p>
        <ol>
          {headings.map((h) => (
            <li>
              <a href={`#${h.slug}`} title={h.text}>
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    ) : (
      <Accordion summary={title}>
        <nav class="art-toc fold" aria-label={title}>
          <ol>
            {headings.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </Accordion>
    ))
}

<style>
  .art-toc-title {
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
  }

  .art-toc ol {
    margin-top: var(--space-3);
    border-left: var(--hairline) solid var(--color-border);
  }

  /* One line a heading: a long one ends in an ellipsis. The heading itself is
     printed in full where the link leads (and in the link's title). */
  .art-toc a {
    display: block;
    /* The rule on the left belongs to the list; the link sits over it. */
    margin-left: calc(var(--hairline) * -1);
    padding: var(--space-2) 0 var(--space-2) var(--space-4);
    border-left: var(--hairline) solid transparent;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-tight);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .art-toc a:hover {
    border-left-color: var(--color-text);
    color: var(--color-text);
  }

  /* Folded, on a phone: no rule, and every link is a full tap target. */
  .art-toc.fold ol {
    margin-top: 0;
    border-left: 0;
  }

  .art-toc.fold a {
    margin-left: 0;
    padding: 0;
    border-left: 0;
    line-height: var(--tap);
  }
</style>
