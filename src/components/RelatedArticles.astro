---
// "Related lessons" at the foot of a tool, data, daily or backtest page.
// Driven by src/lib/related.ts; renders nothing when no listed lesson exists
// in this locale.
import { common } from '../i18n/common';
import { localePath } from '../i18n/config';
import type { Locale } from '../i18n/config';
import { articlePath, getArticlesFor } from '../lib/articles';
import { RELATED } from '../lib/related';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const slugs = RELATED[path] ?? [];
const all = slugs.length > 0 ? await getArticlesFor(locale) : [];
const items = slugs.flatMap((slug) => all.filter((a) => a.entry.data.slug === slug));
---

{
  items.length > 0 && (
    <section class="read">
      <div class="wrap">
        <h2>{common[locale].related}</h2>
        <ol class="entries">
          {items.map(({ entry }) => (
            <li>
              <a href={localePath(locale, articlePath(entry.data.slug))}>{entry.data.title}</a>
              <p>{entry.data.description}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}
