---
// The to-scale bar, the site's signature.
//
// The whole bar is 100% of a quantity (usually the entry price). The light
// part is `room`, a fraction from 0 to 1, drawn at its true proportion: it is
// never enlarged to look better.
//
//   <Scale room={0.0467} label="4.67% of the entry price is left before liquidation." />
//
// `label` is the text alternative and is required: say the number in words.
// Put the exact figures in visible text next to the bar as well (see .ends),
// because a sliver under 1% is hard to read by eye.
//
// To update it from a script, set the custom property and the label:
//   bar.style.setProperty('--room', '0.02'); bar.setAttribute('aria-label', '...');
interface Props {
  /** Fraction of the bar that is light, 0 to 1. Values outside are clamped. */
  room: number;
  /** Text alternative. A full sentence with the number in it. */
  label: string;
  /** 'l' on the home hero, 's' on tool pages. */
  size?: 'l' | 's';
  id?: string;
}

const { room, label, size = 'l', id } = Astro.props;
const clamped = Number.isFinite(room) ? Math.min(1, Math.max(0, room)) : 0;
---

<div
  class:list={['scale', { s: size === 's' }]}
  id={id}
  role="img"
  aria-label={label}
  style={`--room:${clamped.toFixed(4)}`}
>
  <div class="room"></div>
</div>
