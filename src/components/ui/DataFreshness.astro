---
// How old the numbers are and where they come from. Put one next to every
// table, chart or figure that shows market or exchange data.
//
//   <DataFreshness locale={locale} date={snapshotDate(BTCUSDT)} source="Bybit public API" />
//   <DataFreshness locale={locale} time="2026-11-18T16:00:00Z" timeLabel="16:00 UTC"
//                  source="Bybit" sourceHref="https://bybit-exchange.github.io/docs/" />
//   <DataFreshness locale={locale} date={date} stale />
//
// date: the day the data describes ("2026-11-18"), printed as written.
// time: a full ISO timestamp for <time datetime>; print it yourself in
//       `timeLabel` and say the timezone there ("16:00 UTC").
// stale: adds a visible warning. Set it from the data (how old the snapshot
//        is at build time), never leave old data looking current.
// The values come from the data files. Never write a date by hand.
// To update from a script: [data-fresh="date"] and [data-fresh="time"].
import Icon from './Icon.astro';
import { common } from '../../i18n/common';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
  date?: string;
  time?: string;
  timeLabel?: string;
  source?: string;
  sourceHref?: string;
  stale?: boolean;
  id?: string;
  class?: string;
}

const { locale, date, time, timeLabel, source, sourceHref, stale = false, id, class: className } = Astro.props;
const t = common[locale].ui;
// Split "Data as of {date}" around the placeholder so the date can be a <time>.
const around = (template: string, key: string) => {
  const [before = '', after = ''] = template.split(`{${key}}`);
  return { before, after };
};
const dateText = around(t.dataAsOf, 'date');
const timeText = around(t.updated, 'time');
const sourceText = around(t.source, 'name');
---

<p class:list={['freshness', className]} id={id}>
  {
    date && (
      <span>
        <Icon name="calendar" size={14} />
        <span>
          {dateText.before}
          <time class="num" datetime={date} data-fresh="date">{date}</time>
          {dateText.after}
        </span>
      </span>
    )
  }
  {
    time && (
      <span>
        <Icon name="clock" size={14} />
        <span>
          {timeText.before}
          <time class="num" datetime={time} data-fresh="time">{timeLabel ?? time}</time>
          {timeText.after}
        </span>
      </span>
    )
  }
  {
    source && (
      <span>
        <Icon name="database" size={14} />
        <span>
          {sourceText.before}
          {sourceHref ? <a href={sourceHref} rel="noopener">{source}</a> : source}
          {sourceText.after}
        </span>
      </span>
    )
  }
  {
    stale && (
      <span class="freshness-stale">
        <Icon name="triangle-alert" size={14} />
        {t.stale}
      </span>
    )
  }
</p>
