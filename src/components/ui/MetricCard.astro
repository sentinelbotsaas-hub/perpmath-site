---
// One figure with its label: a result, a statistic, a market reading.
//
//   <div class="cards cols-4">
//     <MetricCard label="Win rate" value="38.2" unit="%" />
//     <MetricCard label="Average R" value="-0.21" tone="negative" trend="down"
//                 note="Out of sample, after costs" />
//     <MetricCard label="Liquidation price" value="64,824.4" unit="USDT" valueId="out-price" />
//   </div>
//
// The value is text you formatted (src/lib/fmt.ts); it is set in the number
// face with tabular figures. `tone` colours the figure, and because colour
// must never be the only signal, pass `trend` too (an arrow icon) or make the
// sign part of the value. Every figure must come from the site's data or
// calculations. Give `valueId` when a script updates the value.
//
// `bare` drops the card frame: use it for a row of figures inside a panel
// that already has a border (a card inside a card is not allowed).
import Card from './Card.astro';
import Icon from './Icon.astro';

interface Props {
  label: string;
  value: string;
  unit?: string;
  /** A short line under the figure: the sample, the period, the assumption. */
  note?: string;
  tone?: 'positive' | 'negative' | 'warning' | 'accent';
  /** Colours the value alone, when the note under it has figures of its own with other signs. */
  valueTone?: 'positive' | 'negative';
  /** Colours the note alone, when the signed figure is in the note and the value is not signed. */
  noteTone?: 'positive' | 'negative';
  trend?: 'up' | 'down';
  valueId?: string;
  noteId?: string;
  /** No frame and no padding. */
  bare?: boolean;
  class?: string;
}

const { label, value, unit, note, tone, valueTone, noteTone, trend, valueId, noteId, bare = false, class: className } = Astro.props;
---

{
  bare ? (
    <div class:list={['metric', className]} data-tone={tone}>
      <p class="metric-label">{label}</p>
      <p class="metric-value">
        <span id={valueId} class:list={[{ toned: valueTone }]} data-tone={valueTone}>{value}</span>
        {unit && <span class="metric-unit">{unit}</span>}
      </p>
      {(note || trend) && (
        <p class:list={['metric-note', { toned: noteTone }]} data-tone={noteTone}>
          {trend && <Icon name={trend === 'up' ? 'arrow-up' : 'arrow-down'} size={14} />}
          <span id={noteId}>{note}</span>
        </p>
      )}
    </div>
  ) : (
    <Card class:list={['metric', className]} data-tone={tone}>
      <p class="metric-label">{label}</p>
      <p class="metric-value">
        <span id={valueId} class:list={[{ toned: valueTone }]} data-tone={valueTone}>{value}</span>
        {unit && <span class="metric-unit">{unit}</span>}
      </p>
      {(note || trend) && (
        <p class:list={['metric-note', { toned: noteTone }]} data-tone={noteTone}>
          {trend && <Icon name={trend === 'up' ? 'arrow-up' : 'arrow-down'} size={14} />}
          <span id={noteId}>{note}</span>
        </p>
      )}
    </Card>
  )
}
