---
// Two-way switch built from radio inputs (long or short, a mode). The chosen
// half is filled and set in heavier type. An option whose value is "long" or
// "short" is filled green or red when chosen (components.css); the word is
// always there, so the colour is never the only signal.
//
//   <Segmented name="side" label="Side" value="long"
//              options={[{ value: 'long', label: 'Long' }, { value: 'short', label: 'Short' }]} />
interface Props {
  name: string;
  label: string;
  value: string;
  options: Array<{ value: string; label: string }>;
  /** Extra class on the wrapper, e.g. "calc-wide" to span the form's columns. */
  class?: string;
}

const { name, label, value, options, class: className } = Astro.props;
---

<div class:list={['field', className]} role="radiogroup" aria-labelledby={`${name}-label`}>
  <span class="field-label" id={`${name}-label`}>{label}</span>
  <span class="seg">
    {
      options.map((o) => (
        <label>
          <input type="radio" name={name} value={o.value} checked={o.value === value} />
          <span>{o.label}</span>
        </label>
      ))
    }
  </span>
</div>
