---
// In-sample and out-of-sample side by side: the metrics are the rows and the
// two samples are the columns. Three columns fit a phone without scrolling;
// if they ever do not, the table scrolls inside its own box and the metric
// names stay in view.
//
//   <SampleCompare locale={locale} label={...} views={sampleViews(result, t)} />
//
// `views` comes from ./samples.ts. `surface` says the table sits on a card,
// so the pinned first column takes the card's colour.
//
// A sample with too few trades (the engine's `insufficient_sample`) is
// marked in the two cells that say so: its trade count gets a warning icon,
// its verdict already reads "Too few trades", and both take the warning
// colour. Its average R is printed without a gain or loss colour: at that
// size the figure is noise either way, and a green +0.06 would read as a
// result.
import DataTable from '../ui/DataTable.astro';
import Icon from '../ui/Icon.astro';
import { backtests } from '../../i18n/backtests';
import type { Locale } from '../../i18n/config';
import { toneOf } from './samples';
import type { SampleView } from './samples';

interface Props {
  locale: Locale;
  /** Names the table for screen readers: which strategy, which comparison. */
  label: string;
  views: SampleView[];
  /** Printed under the table. */
  caption?: string;
  surface?: boolean;
  dense?: boolean;
}

const { locale, label, views, caption, surface = false, dense = false } = Astro.props;
const col = backtests[locale].columns;
const tooFew = backtests[locale].verdict.insufficient;

// A share of a whole gets a depth bar at its true length (the full cell is
// 100%); a signed figure takes the colour of its sign.
const share = (pct: number | null) => (pct === null || !Number.isFinite(pct) ? undefined : Math.min(1, Math.max(0, Math.abs(pct) / 100)).toFixed(4));
const rows: Array<{
  head: string;
  cell: (v: SampleView) => string;
  tone?: (v: SampleView) => 'positive' | 'negative' | 'warning' | undefined;
  depth?: (v: SampleView) => string | undefined;
  /** The row whose cell carries the warning icon of a sample with too few trades. */
  flag?: boolean;
}> = [
  { head: col.trades, cell: (v) => v.trades, tone: (v) => (v.insufficient ? 'warning' : undefined), flag: true },
  { head: col.winRate, cell: (v) => v.winRateText, depth: (v) => share(v.winRate) },
  { head: col.avgR, cell: (v) => v.avgR, tone: (v) => (v.insufficient ? undefined : toneOf(v.avgRSign)) },
  { head: col.t, cell: (v) => v.tStat },
  { head: col.maxDrawdown, cell: (v) => v.maxDrawdown, depth: (v) => share(v.maxDrawdownPct), tone: () => 'negative' },
];
---

<DataTable locale={locale} label={label} caption={caption} stickyFirst dense={dense} depth firstWidth="30%" class={surface ? 'bt-compare bt-on-surface' : 'bt-compare'}>
  <thead>
    <tr>
      <th scope="col">{col.metric}</th>
      {views.map((v) => <th scope="col">{v.sample}</th>)}
    </tr>
  </thead>
  <tbody>
    <tr>
      <th scope="row">{col.period}</th>
      {
        views.map((v) => (
          <td class="num bt-when">
            <span>{v.rangeLead}</span> <span>{v.rangeEnd}</span>
          </td>
        ))
      }
    </tr>
    <tr class="bt-total">
      <th scope="row">{col.totalReturn}</th>
      {views.map((v) => <td class="num" data-tone={toneOf(v.totalReturnSign)}>{v.totalReturn}</td>)}
    </tr>
    {
      rows.map((row) => (
        <tr>
          <th scope="row">{row.head}</th>
          {views.map((v) => {
            const depth = row.depth?.(v);
            return depth === undefined ? (
              <td class="num" data-tone={row.tone?.(v)}>
                {row.flag && v.insufficient && <Icon name="triangle-alert" size={14} label={tooFew} />}
                {row.cell(v)}
              </td>
            ) : (
              <td class="num" data-depth data-tone={row.tone?.(v)} style={`--depth:${depth}`}>{row.cell(v)}</td>
            );
          })}
        </tr>
      ))
    }
    <tr>
      <th scope="row">{col.verdict}</th>
      {views.map((v) => <td class="bt-verdict" data-tone={v.insufficient ? 'warning' : undefined}>{v.verdict}</td>)}
    </tr>
  </tbody>
</DataTable>

<style>
  /* The table sits on a card: the pinned column takes the card's colour. */
  :global(.bt-on-surface) {
    --table-bg: var(--color-surface);
  }

  /* ...and the columns sit closer, so three of them fit a card. */
  :global(.bt-on-surface) :is(th, td):not(:first-child) {
    padding-left: var(--space-2);
  }

  :global(.bt-on-surface) :is(th, td):not(:last-child) {
    padding-right: var(--space-2);
  }

  :global(.bt-compare tbody tr:last-child) :is(th, td) {
    border-bottom: 0;
  }

  /* Two dates, one above the other: the columns stay narrow enough for a phone. */
  .bt-when {
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
  }

  .bt-when span {
    display: block;
    white-space: nowrap;
  }

  /* The headline figure of each sample. The sign is printed; the colour repeats it. */
  .bt-total td {
    color: var(--tone, var(--color-text));
    font-size: var(--text-card);
    font-weight: var(--weight-medium);
  }

  /* The warning icon of a sample with too few trades sits on the text line. */
  :global(.bt-compare td .icon) {
    margin-right: var(--space-1);
    vertical-align: -0.12em;
  }

  /* A verdict is a phrase, not a figure: it may wrap. */
  .bt-verdict {
    min-width: 7em;
    color: var(--color-text);
    white-space: normal;
  }
</style>
