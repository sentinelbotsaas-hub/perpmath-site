---
// In-sample and out-of-sample side by side: the metrics are the rows and the
// two samples are the columns. Three columns fit a phone without scrolling;
// if they ever do not, the table scrolls inside its own box and the metric
// names stay in view.
//
//   <SampleCompare locale={locale} label={...} views={sampleViews(result, t)} />
//
// `views` comes from ./samples.ts. `surface` says the table sits on a card,
// so the pinned first column takes the card's colour.
import DataTable from '../ui/DataTable.astro';
import { backtests } from '../../i18n/backtests';
import type { Locale } from '../../i18n/config';
import { toneOf } from './samples';
import type { SampleView } from './samples';

interface Props {
  locale: Locale;
  /** Names the table for screen readers: which strategy, which comparison. */
  label: string;
  views: SampleView[];
  /** Printed under the table. */
  caption?: string;
  surface?: boolean;
  dense?: boolean;
}

const { locale, label, views, caption, surface = false, dense = false } = Astro.props;
const col = backtests[locale].columns;

const rows: Array<{ head: string; cell: (v: SampleView) => string; plain?: boolean }> = [
  { head: col.trades, cell: (v) => v.trades },
  { head: col.winRate, cell: (v) => v.winRateText },
  { head: col.avgR, cell: (v) => v.avgR },
  { head: col.t, cell: (v) => v.tStat },
  { head: col.maxDrawdown, cell: (v) => v.maxDrawdown },
];
---

<DataTable locale={locale} label={label} caption={caption} stickyFirst dense={dense} class={surface ? 'bt-compare bt-on-surface' : 'bt-compare'}>
  <thead>
    <tr>
      <th scope="col">{col.metric}</th>
      {views.map((v) => <th scope="col">{v.sample}</th>)}
    </tr>
  </thead>
  <tbody>
    <tr>
      <th scope="row">{col.period}</th>
      {
        views.map((v) => (
          <td class="num bt-when">
            <span>{v.rangeLead}</span> <span>{v.rangeEnd}</span>
          </td>
        ))
      }
    </tr>
    <tr class="bt-total">
      <th scope="row">{col.totalReturn}</th>
      {views.map((v) => <td class="num" data-tone={toneOf(v.totalReturnSign)}>{v.totalReturn}</td>)}
    </tr>
    {
      rows.map((row) => (
        <tr>
          <th scope="row">{row.head}</th>
          {views.map((v) => (
            <td class="num">{row.cell(v)}</td>
          ))}
        </tr>
      ))
    }
    <tr>
      <th scope="row">{col.verdict}</th>
      {views.map((v) => <td class="bt-verdict">{v.verdict}</td>)}
    </tr>
  </tbody>
</DataTable>

<style>
  /* The table sits on a card: the pinned column takes the card's colour. */
  :global(.bt-on-surface) {
    --table-bg: var(--color-surface);
  }

  /* ...and the columns sit closer, so three of them fit a card. */
  :global(.bt-on-surface) :is(th, td):not(:first-child) {
    padding-left: var(--space-2);
  }

  :global(.bt-on-surface) :is(th, td):not(:last-child) {
    padding-right: var(--space-2);
  }

  :global(.bt-compare tbody tr:last-child) :is(th, td) {
    border-bottom: 0;
  }

  /* The pinned first column has a background of its own (it must cover what
     scrolls under it). In a collapsed-border table the rules belong to the
     table, and that background is painted over them, so the rules vanish in
     the first column. With separate borders every cell draws its own rule. */
  :global(.bt-compare .data-table) {
    border-collapse: separate;
    border-spacing: 0;
  }

  /* Two dates, one above the other: the columns stay narrow enough for a phone. */
  .bt-when {
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
  }

  .bt-when span {
    display: block;
    white-space: nowrap;
  }

  /* The headline figure of each sample. The sign is printed; the colour repeats it. */
  .bt-total td {
    color: var(--tone, var(--color-text));
    font-size: var(--text-card);
    font-weight: var(--weight-medium);
  }

  /* A verdict is a phrase, not a figure: it may wrap. */
  .bt-verdict {
    min-width: 7em;
    color: var(--color-text);
    white-space: normal;
  }
</style>
