---
// A grid backtest on /backtests/: the grid, its market, and its in-sample and
// out-of-sample figures side by side, like StrategyCard for a signal
// strategy. Where that card ends with a verdict, this one ends with the fact
// each sample has to be read with (where the bounds came from, whether price
// stayed inside them). Every figure is read from the result file through
// ./grid-views.ts.
//
// The card is not one big link (it holds a table): the title and the line at
// the foot link to the result's own page.
import Card from '../ui/Card.astro';
import Icon from '../ui/Icon.astro';
import { backtests } from '../../i18n/backtests';
import { localePath } from '../../i18n/config';
import type { Locale } from '../../i18n/config';
import { backtestPath } from '../../lib/backtests/load';
import type { GridResult } from '../../lib/backtests/types';
import { fmt } from '../../lib/fmt';
import GridCompare from './GridCompare.astro';
import { gridViews } from './grid-views';

interface Props {
  locale: Locale;
  result: GridResult;
  /** Heading level of the name. Default 3. */
  level?: 2 | 3;
}

const { locale, result, level = 3 } = Astro.props;
const t = backtests[locale];
const g = t.grid;

const href = localePath(locale, backtestPath(result.slug));
const Heading = level === 2 ? 'h2' : 'h3';
---

<Card as="article" class="bt-gcard">
  <div class="bt-gcard-head">
    <Heading class="card-title">
      <a href={href}>{g.short}</a>
    </Heading>
    <p class="tag num">{result.symbol} {result.interval}</p>
  </div>
  <GridCompare
    locale={locale}
    label={fmt(g.card.label, { name: g.short })}
    views={gridViews(result, t)}
    funding={result.costs.funding_modelled}
    compact
    surface
    dense
  />
  <div class="card-foot">
    <a class="lnk" href={href}>
      {g.card.open}
      <Icon name="arrow-right" size={16} />
    </a>
  </div>
</Card>

<style>
  .bt-gcard-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
  }

  .bt-gcard-head a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    text-decoration-color: var(--color-border-control);
  }

  .bt-gcard-head a:hover {
    text-decoration-color: currentColor;
  }

  .card-foot {
    padding-top: 0;
  }

  .card-foot .lnk {
    font-size: var(--text-sm);
    white-space: normal;
  }
</style>
