---
// The list of calculators: name, the one question it answers, and a link if
// the page exists. Tools that are not built yet are plain text marked
// "Coming"; they are never links.
import { common } from '../i18n/common';
import type { Locale } from '../i18n/config';
import { getTools } from '../lib/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tools = getTools(locale);
const t = common[locale];
---

<ol class="index">
  {
    tools.map((tool) => (
      <li>
        {tool.href ? (
          <a class="name" href={tool.href}>
            {tool.name}
          </a>
        ) : (
          <span class="name">{tool.name}</span>
        )}
        <span class="question">{tool.question}</span>
        <span class="state">{tool.href ? '' : t.coming}</span>
      </li>
    ))
  }
</ol>
