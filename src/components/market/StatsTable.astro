---
// Days liquidated out of a run of days, by leverage, for longs and shorts.
// Behind each count a depth bar shows the same share at its true length: the
// full width of the cell is every day in the run.
//
//   <StatsTable locale={locale} label="BTCUSDT: days liquidated, by leverage"
//     columns={['Leverage', 'Long, days', 'Short, days']} caption="..."
//     rows={[{ leverage: '20x', long: { text: '3 (3.3%)', share: 0.0333, label: '...' }, short: {...} }]}
//     missing="Not offered" />
//
// A side left out of a row (leverage above the contract's limit) prints
// `missing` and draws no bar. Counts and shares come from report.survival90.
import DataTable from '../ui/DataTable.astro';
import type { Locale } from '../../i18n/config';

interface Cell {
  /** The printed count. */
  text: string;
  /** 0 to 1. */
  share: number;
  /** The same figures as a full phrase. Kept for callers; the count itself is the text now. */
  label: string;
}

interface Props {
  locale: Locale;
  label: string;
  /** Leverage, long, short. */
  columns: [string, string, string];
  rows: Array<{ leverage: string; long?: Cell; short?: Cell }>;
  missing: string;
  caption?: string;
  /** Narrowest the table gets before it scrolls sideways; raise it when the cell text is long. */
  minWidth?: string;
}

const { locale, label, columns, rows, missing, caption, minWidth = '19rem' } = Astro.props;
---

<DataTable locale={locale} label={label} caption={caption} stickyFirst hint depth firstWidth="22%" minWidth={minWidth}>
  <thead>
    <tr>
      <th scope="col">{columns[0]}</th>
      <th scope="col" class="mk-share">{columns[1]}</th>
      <th scope="col" class="mk-share">{columns[2]}</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map((row) => (
        <tr>
          <th scope="row" class="num">
            {row.leverage}
          </th>
          {[row.long, row.short].map((cell) =>
            cell ? (
              <td class="num mk-share" data-depth data-tone="negative" style={`--depth:${Math.min(1, Math.max(0, cell.share)).toFixed(4)}`}>
                {cell.text}
              </td>
            ) : (
              <td class="mk-share">{missing}</td>
            ),
          )}
        </tr>
      ))
    }
  </tbody>
</DataTable>
