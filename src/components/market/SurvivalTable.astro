---
// The leverage survival table of a daily report: one row per leverage, and
// for each side a bar whose full length is the room at that leverage and
// whose filled part is the day's largest move against that side. A full bar
// is a liquidation; the text under it says so, with the hour.
//
//   <SurvivalTable locale={locale} report={report} />
//
// It is a real table. On a phone each row becomes a block (leverage and room
// on one line, then the long and the short bar), so nothing scrolls sideways;
// the ARIA roles keep it a table for screen readers when the layout changes.
// Every figure comes from report.survival and report.day.
import Icon from '../ui/Icon.astro';
import Meter from '../ui/Meter.astro';
import type { Locale } from '../../i18n/config';
import { daily } from '../../i18n/daily';
import { fmt, formatPercent } from '../../lib/fmt';
import type { Side, SurvivalRow } from '../../lib/market/compute';
import type { MarketReport } from '../../lib/market/report';
import { hourLabel } from '../../lib/market/view';

interface Props {
  locale: Locale;
  report: MarketReport;
}

const { locale, report } = Astro.props;
const d = daily[locale];
const t = d.report;
const { day, survival } = report;
const lev = (n: number) => fmt(d.lev, { n });
const moves = { long: day.adverseLong, short: day.adverseShort };
const drop = formatPercent(day.adverseLong);
const rise = formatPercent(day.adverseShort);

const outcome = (row: SurvivalRow, side: Side) => {
  const o = row[side];
  if (!o.liquidated) return side === 'long' ? t.longSurvived : t.shortSurvived;
  return fmt(side === 'long' ? t.longLiquidated : t.shortLiquidated, { hour: hourLabel(o.hourUtc ?? 0) });
};
const meterLabel = (row: SurvivalRow, side: Side) =>
  fmt(t.meter, {
    lev: lev(row.leverage),
    side: side === 'long' ? t.sideLong : t.sideShort,
    move: formatPercent(moves[side]),
    room: formatPercent(row.room),
  });
const sides: Array<{ side: Side; name: string }> = [
  { side: 'long', name: t.sideLong },
  { side: 'short', name: t.sideShort },
];
---

<table class="mk-surv" role="table" aria-label={t.barsLabel}>
  <thead role="rowgroup">
    <tr role="row">
      <th role="columnheader" scope="col">{t.columns.leverage}</th>
      <th role="columnheader" scope="col">{t.columns.room}</th>
      <th role="columnheader" scope="col">{fmt(t.columns.long, { drop })}</th>
      <th role="columnheader" scope="col">{fmt(t.columns.short, { rise })}</th>
    </tr>
  </thead>
  <tbody role="rowgroup">
    {
      survival.map((row) => (
        <tr role="row">
          <th role="rowheader" scope="row" class="num mk-surv-lev">
            {lev(row.leverage)}
          </th>
          <td role="cell" class="mk-surv-room">
            <span class="mk-surv-key" aria-hidden="true">
              {t.columns.room}
            </span>
            <span class="num">{formatPercent(row.room)}</span>
          </td>
          {sides.map(({ side, name }) => (
            <td role="cell" class="mk-surv-side" data-dead={row[side].liquidated ? '' : undefined}>
              <span class="mk-surv-key" aria-hidden="true">
                {name}
              </span>
              <Meter
                value={Math.min(1, moves[side] / row.room)}
                label={meterLabel(row, side)}
                tone={row[side].liquidated ? 'negative' : undefined}
                size="tall"
              />
              <span class="mk-surv-out">
                <Icon name={row[side].liquidated ? 'x' : 'check'} size={16} />
                {outcome(row, side)}
              </span>
            </td>
          ))}
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .mk-surv {
    table-layout: fixed;
  }

  .mk-surv :is(th, td) {
    padding-block: var(--space-4);
    text-align: left;
    vertical-align: top;
  }

  .mk-surv thead th {
    vertical-align: bottom;
  }

  .mk-surv :is(th, td):nth-child(1) {
    width: 7rem;
  }

  .mk-surv :is(th, td):nth-child(2) {
    width: 7rem;
  }

  .mk-surv-lev {
    font-size: var(--text-card);
    font-weight: var(--weight-medium);
  }

  .mk-surv-room {
    font-size: var(--text-md);
  }

  /* Column names repeated inside the cells: for the stacked layout only. */
  .mk-surv-key {
    display: none;
    color: var(--color-text-secondary);
  }

  /* "long" and "short" are written for the middle of a sentence. */
  .mk-surv-key::first-letter {
    text-transform: uppercase;
  }

  /* The track is the room: it has to be seen as a length in both themes. */
  .mk-surv-side :global(.meter) {
    margin-top: var(--space-1);
    background: var(--color-border-hover);
  }

  .mk-surv-out {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    color: var(--color-text-secondary);
  }

  .mk-surv-side[data-dead] .mk-surv-out {
    color: var(--color-negative);
  }

  @media (max-width: 720px) {
    .mk-surv,
    .mk-surv tbody {
      display: block;
    }

    /* Still read out as column headers; the cells repeat them for the eye. */
    .mk-surv thead {
      position: absolute;
      width: var(--hairline);
      height: var(--hairline);
      overflow: hidden;
      clip-path: inset(50%);
    }

    .mk-surv tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: baseline;
      gap: var(--space-3) var(--space-4);
      padding-block: var(--space-5);
      border-bottom: var(--hairline) solid var(--color-border);
    }

    .mk-surv tbody :is(th, td) {
      width: auto;
      padding: 0;
      border-bottom: 0;
    }

    .mk-surv-room {
      display: flex;
      gap: var(--space-2);
      font-size: var(--text-sm);
    }

    .mk-surv-side {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 3rem minmax(0, 1fr);
      align-items: center;
      gap: 0 var(--space-3);
    }

    .mk-surv-key {
      display: inline;
    }

    .mk-surv-side :global(.meter) {
      margin-top: 0;
    }

    .mk-surv-out {
      grid-column: 2;
    }
  }
</style>
