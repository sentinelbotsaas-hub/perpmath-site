---
// The one layout. Every page renders through it.
//
//   <Base locale={locale} path="/tools/" title="..." description="...">
//     <section class="section"><div class="wrap">...</div></section>
//   </Base>
//
// `path` is the locale-less path of the page ("/", "/tools/x/"). Canonical,
// hreflang and the language switcher are all built from it.
//
// The layout gives a page: the <head> (SEO tags, fonts, the theme script),
// the skip link, the sticky header, <main>, the related-lessons block and the
// footer. It adds no wrapper inside <main>: a page is a stack of full-width
// <section class="section"> bands, each with a .wrap inside.
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import tokensSource from '../styles/tokens.css?raw';
import Footer from '../components/Footer.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import Nav from '../components/Nav.astro';
import { common } from '../i18n/common';
import { absoluteUrl, alternates, htmlLang, locales, ogLocale } from '../i18n/config';
import type { Locale } from '../i18n/config';
import { SITE_NAME, serializeJsonLd } from '../lib/seo';
import { fontFaceCss, preloadFonts } from './fonts';

interface Props {
  locale: Locale;
  /** Locale-less path of this page, with slashes: "/", "/tools/". */
  path: string;
  /** Page title without the site name. */
  title: string;
  /** Meta description, also used for Open Graph. */
  description: string;
  /** Set when the <title> should be exactly `title` (the home page). */
  bareTitle?: boolean;
  /** From before the redesign, when the nav took the colour of the first section. Ignored. */
  surface?: 'measure' | 'read';
  /** Locales this page exists in. Default: all three. Articles pass fewer. */
  availableLocales?: readonly Locale[];
  /** Keep the page out of search results (utility pages). */
  noindex?: boolean;
  /**
   * Path the language switcher points at. Default: this page. Pages that
   * exist only once (404, /go/ fallbacks) pass "/" so it leads to the homes.
   */
  switcherPath?: string;
  ogType?: 'website' | 'article';
  /** One JSON-LD object or several. See src/lib/seo.ts. */
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  locale,
  path,
  title,
  description,
  bareTitle = false,
  availableLocales = locales,
  noindex = false,
  switcherPath,
  ogType = 'website',
  jsonLd,
} = Astro.props;

const t = common[locale];
// Display width, CJK counted double. Past 60 the brand suffix is what goes.
const width = (s: string) => [...s].reduce((n, ch) => n + (ch.charCodeAt(0) > 0x2e7f ? 2 : 1), 0);
const suffixed = `${title} | ${SITE_NAME}`;
const fullTitle = bareTitle || width(suffixed) > 60 ? title : suffixed;
const canonical = absoluteUrl(locale, path);
const hreflangs = noindex ? [] : alternates(path, availableLocales);
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// The design stamp (the "Hallmark" comment lines at the top of tokens.css).
// The CSS minifier strips comments from the bundled stylesheet, so the stamp
// is repeated here; the design lint looks for it at the top of a page's CSS.
const stamp = tokensSource
  .split('\n')
  .map((line) => line.trim())
  .filter((line) => line.startsWith('/* Hallmark'))
  .join('\n');
const fontFaces = `${stamp}\n${fontFaceCss(locale)}\n`;

// Runs before the first paint. It marks the document as scripted (the header
// shows its script-only controls) and applies the stored theme, so a reload
// never flashes the default one. Storage may be blocked: then the default
// (dark) stays. Keep it tiny and dependency-free; the key and the three
// values are the same as in src/scripts/theme.ts.
const bootScript = `(function(){var d=document.documentElement;d.setAttribute("data-js","");try{var t=localStorage.getItem("perpmath-theme");if(t==="light"||t==="dark"||t==="system")d.setAttribute("data-theme",t)}catch(e){}})();`;
---

<!doctype html>
<html lang={htmlLang[locale]} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline set:html={bootScript} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hreflangs.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'max-image-preview:large'} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {
      availableLocales
        .filter((l) => l !== locale)
        .map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)
    }
    {/* public/og-<locale>.png: the home hero at 1200x630, one per locale. */}
    <meta property="og:image" content={new URL(`/og-${locale}.png`, canonical).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preloadFonts(locale).map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <style is:inline set:html={fontFaces}></style>
    <style is:inline>
      html { overflow-x: clip; }
      body { overflow-x: clip; }
    </style>

    {jsonLdList.map((item) => <script is:inline type="application/ld+json" set:html={serializeJsonLd(item)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{t.skipToContent}</a>
    <Nav locale={locale} path={switcherPath ?? path} availableLocales={availableLocales} />
    <main id="main" tabindex="-1">
      <slot />
      <RelatedArticles locale={locale} path={path} />
    </main>
    <Footer locale={locale} />
    <script>
      import '../scripts/theme.ts';
      import '../scripts/nav.ts';
    </script>
  </body>
</html>
