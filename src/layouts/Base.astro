---
// The one layout. Every page renders through it.
//
//   <Base locale={locale} path="/tools/" title="..." description="...">
//     <section class="read"><div class="wrap">...</div></section>
//   </Base>
//
// `path` is the locale-less path of the page ("/", "/tools/x/"). Canonical,
// hreflang and the language switcher are all built from it.
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import tokensSource from '../styles/tokens.css?raw';
import rethinkSans from '@fontsource-variable/rethink-sans/files/rethink-sans-latin-wght-normal.woff2?url';
import azeretMono400 from '@fontsource/azeret-mono/files/azeret-mono-latin-400-normal.woff2?url';
import azeretMono500 from '@fontsource/azeret-mono/files/azeret-mono-latin-500-normal.woff2?url';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { common } from '../i18n/common';
import { absoluteUrl, alternates, htmlLang, locales, ogLocale } from '../i18n/config';
import type { Locale } from '../i18n/config';
import { SITE_NAME, serializeJsonLd } from '../lib/seo';

interface Props {
  locale: Locale;
  /** Locale-less path of this page, with slashes: "/", "/tools/". */
  path: string;
  /** Page title without the site name. */
  title: string;
  /** Meta description, also used for Open Graph. */
  description: string;
  /** Set when the <title> should be exactly `title` (the home page). */
  bareTitle?: boolean;
  /** Surface of the first section, so the nav sits on the same colour. */
  surface?: 'measure' | 'read';
  /** Locales this page exists in. Default: all three. Articles pass fewer. */
  availableLocales?: readonly Locale[];
  /** Keep the page out of search results (utility pages). */
  noindex?: boolean;
  /**
   * Path the language switcher points at. Default: this page. Pages that
   * exist only once (404, /go/ fallbacks) pass "/" so it leads to the homes.
   */
  switcherPath?: string;
  ogType?: 'website' | 'article';
  /** One JSON-LD object or several. See src/lib/seo.ts. */
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  locale,
  path,
  title,
  description,
  bareTitle = false,
  surface = 'read',
  availableLocales = locales,
  noindex = false,
  switcherPath,
  ogType = 'website',
  jsonLd,
} = Astro.props;

const t = common[locale];
const fullTitle = bareTitle ? title : `${title} | ${SITE_NAME}`;
const canonical = absoluteUrl(locale, path);
const hreflangs = noindex ? [] : alternates(path, availableLocales);
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// Latin subsets only. Chinese text uses system fonts (see tokens.css).
const U_LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
// The design stamp (the "Hallmark" comment lines at the top of tokens.css).
// The CSS minifier strips comments from the bundled stylesheet, so the stamp
// is repeated here; the design lint looks for it at the top of a page's CSS.
const stamp = tokensSource
  .split('\n')
  .map((line) => line.trim())
  .filter((line) => line.startsWith('/* Hallmark'))
  .join('\n');
const fontFaces = `${stamp}
@font-face{font-family:"Rethink Sans";font-style:normal;font-weight:400 800;font-display:swap;src:url(${rethinkSans}) format("woff2-variations");unicode-range:${U_LATIN}}
@font-face{font-family:"Azeret Mono";font-style:normal;font-weight:400;font-display:swap;src:url(${azeretMono400}) format("woff2");unicode-range:${U_LATIN}}
@font-face{font-family:"Azeret Mono";font-style:normal;font-weight:500;font-display:swap;src:url(${azeretMono500}) format("woff2");unicode-range:${U_LATIN}}
`;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hreflangs.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'max-image-preview:large'} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {
      availableLocales
        .filter((l) => l !== locale)
        .map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)
    }
    {/* public/og-<locale>.png: the home hero at 1200x630, one per locale. */}
    <meta property="og:image" content={new URL(`/og-${locale}.png`, canonical).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={rethinkSans} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>
    <style is:inline>
      html { overflow-x: clip; }
      body { overflow-x: clip; }
    </style>

    {jsonLdList.map((item) => <script is:inline type="application/ld+json" set:html={serializeJsonLd(item)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{t.skipToContent}</a>
    <Nav locale={locale} path={switcherPath ?? path} surface={surface} availableLocales={availableLocales} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
