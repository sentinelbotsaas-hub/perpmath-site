---
// /backtests/<slug>/: one published backtest. A page is generated for every
// file in src/data/backtests/ (written by scripts/backtests-import.mjs) in
// all three locales.
//
// Every figure on the page comes from that file: the metrics, the dates, the
// costs, the parameter values inside the rule sentences, the equity curve and
// the drawdown drawn from it. Nothing is typed in by hand, and a result this
// page cannot describe (an unknown strategy, parameter, exchange or timing
// rule) stops the build.
//
// Outline: the result (both samples side by side), the charts, the rules and
// their parameters, the assumptions and what is left out, how to rerun it.
// The result file keeps daily equity points but no list of trades, so there
// is an equity curve and a drawdown chart and no histogram of trade returns.
//
// There is no exchange link on this page. The actions are "run it yourself"
// and "view the code".
import Cta from '../../../components/Cta.astro';
import EquityCharts from '../../../components/research/EquityCharts.astro';
import SampleCompare from '../../../components/research/SampleCompare.astro';
import { sampleViews, toneOf } from '../../../components/research/samples';
import Card from '../../../components/ui/Card.astro';
import FormulaBlock from '../../../components/ui/FormulaBlock.astro';
import Icon from '../../../components/ui/Icon.astro';
import Meter from '../../../components/ui/Meter.astro';
import PageContainer from '../../../components/ui/PageContainer.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import { backtests } from '../../../i18n/backtests';
import { bot } from '../../../i18n/bot';
import { common } from '../../../i18n/common';
import { localeParam, localePath, locales } from '../../../i18n/config';
import type { Locale } from '../../../i18n/config';
import Base from '../../../layouts/Base.astro';
import { reproduceCommands, resultSourceUrl, strategySourceUrl } from '../../../lib/backtests/engine';
import { formatCount, formatDay, formatMoney, formatParam, formatRate, formatUtc } from '../../../lib/backtests/format';
import { backtestPath, results } from '../../../lib/backtests/load';
import type { BacktestResult } from '../../../lib/backtests/types';
import { lostInBothSamples } from '../../../lib/backtests/verdict';
import { fmt } from '../../../lib/fmt';
import { breadcrumbLd } from '../../../lib/seo';

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    results.map((result) => ({
      params: { locale: localeParam(locale), slug: result.slug },
      props: { locale, result },
    })),
  );
}

interface Props {
  locale: Locale;
  result: BacktestResult;
}

const { locale, result } = Astro.props;
const t = backtests[locale];
const d = t.detail;
const c = common[locale];
const PATH = backtestPath(result.slug);
const stop = (message: string): never => {
  throw new Error(`backtests/${result.slug}: ${message}`);
};

// --- what this page knows how to describe ---------------------------------
const strategy =
  t.strategies[result.strategy as keyof typeof t.strategies] ??
  stop(`no strings for strategy "${result.strategy}" in src/i18n/backtests.ts`);
if (result.data.exchange !== 'bybit') stop(`the data strings say Bybit, the result says "${result.data.exchange}"`);
const { timing } = result;
if (timing.signal !== 'bar close' || timing.fill !== 'next bar open' || timing.same_bar_stop_and_target !== 'stop first') {
  stop('the engine timing rules differ from the ones the "Fills" strings describe');
}
if (!timing.lookahead_check.passed) stop('the look-ahead check did not pass');

// --- figures --------------------------------------------------------------
const na = t.na;
const sep = locale === 'en' ? ': ' : '：';
const { symbol, interval } = result;
const execution = result.config.execution;
const name = strategy.name;

const blocks = sampleViews(result, t).map((view) => ({
  ...view,
  verdictLine: fmt(d.result.verdictLine, { verdict: view.verdict, t: view.tStat, n: view.trades }),
}));
const [inSample, outOfSample] = blocks;

const head = fmt(lostInBothSamples(result) ? d.headLost : d.head, { name, symbol });
const sub = fmt(d.sub, { symbol, interval, is: inSample.totalReturn, oos: outOfSample.totalReturn });
const title = fmt(d.title, { name, symbol, interval });
const description = fmt(d.description, {
  name,
  symbol,
  interval,
  isTrades: inSample.trades,
  oosTrades: outOfSample.trades,
});

// --- the rules, with the parameter values of this run filled in -------------
const paramValues = Object.fromEntries(
  Object.entries(result.config.params).map(([key, value]) => [key, formatParam(value) ?? na]),
);
const rules = strategy.rules.map((rule) => {
  const text = fmt(rule.text, paramValues);
  if (/\{\w+\}/.test(text)) stop(`a rule mentions a parameter this result does not have: ${text}`);
  return { head: rule.head, text };
});
const params = Object.entries(paramValues).map(([key, value]) => ({
  key,
  value,
  label: t.params[key as keyof typeof t.params] ?? stop(`no label for parameter "${key}" in src/i18n/backtests.ts`),
}));

// --- run it yourself ------------------------------------------------------------
const commands = reproduceCommands(result);
const steps = bot[locale].quickstart;
// A SHA-256 is 64 characters: when it has to wrap, it wraps in the middle.
const halves = (hash: string) => [hash.slice(0, hash.length / 2), hash.slice(hash.length / 2)];

const trail = [
  { name: c.breadcrumb.home, path: '/' },
  { name: t.crumb, path: '/backtests/' },
  { name, path: PATH },
];
const jsonLd = breadcrumbLd(locale, trail);
---

<Base locale={locale} path={PATH} title={title} description={description} jsonLd={jsonLd}>
  <PageContainer lead>
    <PageHeader locale={locale} title={head} lede={sub} breadcrumb={trail}>
      <p slot="meta" class="bt-meta">
        <span>{fmt(d.data.marketValue, { symbol, interval })}</span>
        <span class="num">{fmt(t.range, { from: formatDay(result.data.first_bar), to: formatDay(result.data.last_bar) })}</span>
      </p>
      <Cta
        locale={locale}
        pageType="backtest"
        position="hero"
        primary={{ label: d.primary, href: '#run-it-yourself' }}
        secondary={{ label: d.secondary, href: strategySourceUrl(result.strategy) }}
      />
    </PageHeader>
  </PageContainer>

  <PageContainer flush id="result">
    <SectionHeader title={d.result.head} />
    <div class="cards cols-2">
      {
        blocks.map((b) => (
          <Card class="bt-return" data-tone={toneOf(b.totalReturnSign)}>
            <p class="result-label">{d.result.totalReturn[b.key]}</p>
            <p class="result-value">{b.totalReturn}</p>
            <p class="bt-return-note">{b.verdictLine}</p>
          </Card>
        ))
      }
    </div>
    <div class="bt-result">
      <div>
        <SampleCompare
          locale={locale}
          label={d.compare.label}
          views={blocks}
          caption={fmt(d.result.computed, { version: result.package_version, date: formatUtc(result.generated_at) })}
        />
      </div>
      <div id="win-rate">
        <h3 class="h-card">{d.winRate.head}</h3>
        {
          blocks.map((b) =>
            b.winRate === null ? (
              <p class="bt-rate-none">{b.sample + sep + na}</p>
            ) : (
              <div class="bt-rate">
                <Meter
                  size="tall"
                  value={b.winRate / 100}
                  label={fmt(d.winRate.barLabel, { sample: b.sample, pct: b.winRateText, wins: b.wins, trades: b.trades })}
                />
                <div class="bt-rate-ends">
                  <span>{fmt(d.winRate.line, { sample: b.sample, pct: b.winRateText, wins: b.wins, trades: b.trades })}</span>
                  <span>{fmt(d.winRate.full, { trades: b.trades })}</span>
                </div>
              </div>
            ),
          )
        }
        <p class="bt-small">{d.winRate.note}</p>
      </div>
    </div>
  </PageContainer>

  <PageContainer flush id="equity">
    <SectionHeader title={d.chart.head} />
    <EquityCharts locale={locale} result={result} name={name} />
    {
      result.source.trades_dropped && (
        <p class="bt-small bt-after-charts">
          {d.distribution.note}{' '}
          <a href={resultSourceUrl(result)} rel="noopener">{d.run.full}</a>
        </p>
      )
    }
  </PageContainer>

  <PageContainer band id="rules">
    <SectionHeader title={d.sections.rules}>
      <a slot="action" class="lnk" href={strategySourceUrl(result.strategy)} rel="noopener">
        {d.secondary}
        <Icon name="arrow-right" size={16} />
      </a>
    </SectionHeader>
    <div class="bt-rules-wrap">
      <ol class="bt-rules">
        {
          rules.map((rule, i) => (
            <li>
              <span class="num bt-step" aria-hidden="true">{i + 1}</span>
              <h3 class="h-card">{rule.head}</h3>
              <p>{rule.text}</p>
            </li>
          ))
        }
      </ol>
      <div id="parameters" class="bt-params">
        <h3 class="h-card">{d.params.head}</h3>
        <dl class="bt-kv">
          {
            params.map((p) => (
              <div>
                <dt>
                  {p.label}
                  <code>{p.key}</code>
                </dt>
                <dd class="num">{p.value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="bt-small">{d.params.note}</p>
      </div>
    </div>
  </PageContainer>

  <PageContainer id="assumptions">
    <SectionHeader title={d.sections.assumptions} />
    <div class="bt-assume">
      <div id="costs">
        <h3 class="h-card">{d.costs.head}</h3>
        <dl class="bt-kv">
          <div>
            <dt>{d.costs.fee}</dt>
            <dd>{fmt(d.costs.feeValue, { rate: formatRate(result.costs.fee_rate_per_side) })}</dd>
          </div>
          <div>
            <dt>{d.costs.slippage}</dt>
            <dd>{fmt(d.costs.slippageValue, { rate: formatRate(result.costs.slippage_per_fill) })}</dd>
          </div>
          <div>
            <dt>{d.costs.size}</dt>
            <dd>{fmt(d.costs.sizeValue, { size: formatRate(execution.notional_fraction) })}</dd>
          </div>
          <div>
            <dt>{d.costs.capital}</dt>
            <dd class="num">{formatMoney(execution.initial_capital)}</dd>
          </div>
        </dl>
        <p class="bt-small">{d.costs.note}</p>
      </div>

      <div id="fills">
        <h3 class="h-card">{d.fills.head}</h3>
        <dl class="bt-kv">
          <div>
            <dt>{d.fills.signal}</dt>
            <dd>{d.fills.signalValue}</dd>
          </div>
          <div>
            <dt>{d.fills.fill}</dt>
            <dd>{d.fills.fillValue}</dd>
          </div>
          <div>
            <dt>{d.fills.both}</dt>
            <dd>{d.fills.bothValue}</dd>
          </div>
          <div>
            <dt>{d.fills.lookahead}</dt>
            <dd>{fmt(d.fills.lookaheadValue, { runs: formatCount(timing.lookahead_check.shortened_runs) })}</dd>
          </div>
        </dl>
      </div>

      <div id="not-modelled">
        <h3 class="h-card">{d.omitted.head}</h3>
        <ul class="bt-omitted">
          {!result.costs.funding_modelled && <li>{d.omitted.funding}</li>}
          {d.omitted.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </PageContainer>

  <PageContainer band id="run-it-yourself">
    <SectionHeader title={d.run.head} />
    <div class="bt-run">
      <div class="bt-commands">
        <FormulaBlock label={steps.download} formula={commands.download} />
        <FormulaBlock label={steps.backtest} formula={commands.backtest} />
        <div class="bt-more">
          <a class="lnk" href={localePath(locale, '/bot/#quickstart')}>{d.run.install}</a>
          <a class="lnk" href={resultSourceUrl(result)} rel="noopener">{d.run.full}</a>
          <a class="lnk" href={localePath(locale, '/backtests/')}>{d.back}</a>
        </div>
      </div>

      <div id="data">
        <h3 class="h-card">{d.data.head}</h3>
        <dl class="bt-kv">
          <div>
            <dt>{d.data.market}</dt>
            <dd>{fmt(d.data.marketValue, { symbol, interval })}</dd>
          </div>
          <div>
            <dt>{d.data.first}</dt>
            <dd class="num">{formatUtc(result.data.first_bar)}</dd>
          </div>
          <div>
            <dt>{d.data.last}</dt>
            <dd class="num">{formatUtc(result.data.last_bar)}</dd>
          </div>
          <div>
            <dt>{d.data.bars}</dt>
            <dd>
              {
                fmt(d.data.barsValue, {
                  bars: formatCount(result.data.bars),
                  missing: formatCount(result.data.missing_bars),
                })
              }
            </dd>
          </div>
          <div>
            <dt>{d.data.split}</dt>
            <dd class="num">{formatUtc(result.split.oos_start)}</dd>
          </div>
          <div class="bt-hash">
            <dt>{d.data.hash}</dt>
            <dd class="num">{halves(result.data.file_sha256)[0]}<wbr />{halves(result.data.file_sha256)[1]}</dd>
          </div>
          <div class="bt-hash">
            <dt>{d.data.resultHash}</dt>
            <dd class="num">{halves(result.source.sha256)[0]}<wbr />{halves(result.source.sha256)[1]}</dd>
          </div>
        </dl>
      </div>
    </div>
  </PageContainer>
</Base>

<style>
  /* Market and period under the lede: two facts, a gap between them. */
  .bt-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* The two total returns. The sign is printed; the colour repeats it. */
  .bt-return .result-value {
    color: var(--tone, var(--color-text));
  }

  .bt-return-note {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  /* The full comparison beside the win-rate bars. */
  .bt-result {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-10);
    align-items: start;
    margin-top: var(--space-10);
  }

  .bt-rate {
    margin-top: var(--space-5);
  }

  .bt-rate-ends {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--space-4);
    margin-top: var(--space-2);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .bt-rate-ends span:last-child {
    color: var(--color-text-muted);
  }

  .bt-rate-none {
    margin-top: var(--space-5);
    color: var(--color-text-secondary);
  }

  .bt-small {
    max-width: 72ch;
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .bt-small a {
    color: var(--color-accent);
  }

  .bt-after-charts {
    font-size: var(--text-sm);
  }

  /* The rules, in the order the strategy applies them, and beside them the
     parameter values those rules were run with. */
  .bt-rules-wrap {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: var(--space-12) var(--space-16);
    align-items: start;
  }

  .bt-rules {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-10);
  }

  .bt-rules li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: var(--hairline) solid var(--color-border-hover);
  }

  .bt-step {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .bt-rules p {
    color: var(--color-text-secondary);
  }

  .bt-params {
    max-width: var(--measure);
  }

  /* A parameter's value is short: the label takes the room, the value sits at the end. */
  .bt-params .bt-kv > div {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .bt-params .bt-kv dd {
    text-align: right;
  }

  /* Label and value pairs: one pair a row, a rule under each. */
  .bt-kv {
    margin-top: var(--space-3);
    border-top: var(--hairline) solid var(--color-border-hover);
  }

  .bt-kv > div {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-1) var(--space-5);
    padding-block: var(--space-3);
    border-bottom: var(--hairline) solid var(--color-border);
    font-size: var(--text-sm);
  }

  .bt-kv dt {
    color: var(--color-text-secondary);
  }

  .bt-kv dt code {
    display: block;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .bt-kv dd {
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  /* A SHA-256 is 64 characters: give it the full row. */
  .bt-kv > .bt-hash {
    grid-template-columns: minmax(0, 1fr);
  }

  .bt-hash dd {
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
  }

  .bt-assume {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-10);
    align-items: start;
  }

  .bt-omitted {
    margin-top: var(--space-3);
    border-top: var(--hairline) solid var(--color-border-hover);
    font-size: var(--text-sm);
  }

  .bt-omitted li {
    padding-block: var(--space-3);
    border-bottom: var(--hairline) solid var(--color-border);
    color: var(--color-text);
  }

  .bt-run {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-10);
    align-items: start;
  }

  .bt-commands {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }

  .bt-more {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-6);
  }

  .bt-more .lnk {
    white-space: normal;
  }

  @media (max-width: 1100px) {
    .bt-rules-wrap {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 960px) {
    .bt-result,
    .bt-run {
      grid-template-columns: minmax(0, 1fr);
    }

    .bt-assume {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .bt-rules,
    .bt-assume {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }
  }
</style>
