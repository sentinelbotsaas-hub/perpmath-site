---
// /backtests/<slug>/: one published backtest. A page is generated for every
// file in src/data/backtests/ (written by scripts/backtests-import.mjs) in
// all three locales.
//
// There are two kinds of result and each has its own page layout:
// - a signal strategy (fvg, liquidity_sweep, ma_cross, order_block,
//   break_of_structure, breaker_block): StrategyDetail.astro;
// - a grid backtest ("strategy": "grid"): GridDetail.astro.
// Both render the whole page, <Base> included, from the result file alone.
import GridDetail from '../../../components/research/GridDetail.astro';
import StrategyDetail from '../../../components/research/StrategyDetail.astro';
import { localeParam, locales } from '../../../i18n/config';
import type { Locale } from '../../../i18n/config';
import { allResults } from '../../../lib/backtests/load';
import { isGridResult } from '../../../lib/backtests/types';
import type { AnyResult } from '../../../lib/backtests/types';

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    allResults.map((result) => ({
      params: { locale: localeParam(locale), slug: result.slug },
      props: { locale, result },
    })),
  );
}

interface Props {
  locale: Locale;
  result: AnyResult;
}

const { locale, result } = Astro.props;
---

{isGridResult(result) ? <GridDetail locale={locale} result={result} /> : <StrategyDetail locale={locale} result={result} />}
