---
// /backtests/: every published backtest in one table, in-sample and
// out-of-sample, with a one-line verdict.
//
// The rows are read from src/data/backtests/*.json; nothing is typed in. The
// verdict is decided by src/lib/backtests/verdict.ts and the same rule is
// printed under the table, with its thresholds taken from that file.
// No colour says good or bad: a loss is a minus sign and a sentence.
import Cta from '../../../components/Cta.astro';
import { backtests } from '../../../i18n/backtests';
import { common } from '../../../i18n/common';
import { localePath, localeStaticPaths } from '../../../i18n/config';
import type { Locale } from '../../../i18n/config';
import Base from '../../../layouts/Base.astro';
import { REPO_URL } from '../../../lib/backtests/engine';
import { formatCount, formatDay, formatPct, formatSigned } from '../../../lib/backtests/format';
import { backtestPath, results } from '../../../lib/backtests/load';
import { SAMPLE_KEYS } from '../../../lib/backtests/types';
import { MIN_TRADES, T_THRESHOLD, lostInBothSamples, verdictOf } from '../../../lib/backtests/verdict';
import type { VerdictCode } from '../../../lib/backtests/verdict';
import { fmt } from '../../../lib/fmt';
import { breadcrumbLd } from '../../../lib/seo';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = backtests[locale];
const x = t.index;
const c = common[locale];
const PATH = '/backtests/';

if (results.length === 0) throw new Error('backtests: src/data/backtests/ is empty. Run scripts/backtests-import.mjs.');

const na = t.na;
const groups = results.map((result) => {
  const strategy = t.strategies[result.strategy as keyof typeof t.strategies];
  if (!strategy) throw new Error(`backtests: no strings for strategy "${result.strategy}" in src/i18n/backtests.ts`);
  return {
    name: strategy.short,
    href: localePath(locale, backtestPath(result.slug)),
    market: `${result.symbol} ${result.interval}`,
    rows: SAMPLE_KEYS.map((key) => {
      const block = result[key];
      const m = block.metrics;
      return {
        sample: t.samples[key],
        // "2025-11-18 to" and "2026-07-30": two parts, so a phone can stack them
        rangeLead: fmt(t.range, { from: formatDay(block.first_bar), to: '' }).trim(),
        rangeEnd: formatDay(block.last_bar),
        trades: formatCount(m.trades),
        winRate: formatPct(m.win_rate_pct) ?? na,
        avgR: formatSigned(m.avg_r) ?? na,
        tStat: formatSigned(m.t_stat) ?? na,
        maxDrawdown: formatPct(m.max_drawdown_pct) ?? na,
        verdict: t.verdict[verdictOf(m)],
      };
    }),
  };
});

const n = formatCount(results.length);
const head = fmt(results.every(lostInBothSamples) ? x.headAllLost : x.head, { n });
const caption = results.every((r) => !r.costs.funding_modelled) ? x.caption : x.captionPlain;

// The rule, in the order verdict.ts checks it.
const thresholds = {
  min: formatCount(MIN_TRADES),
  neg: formatSigned(-T_THRESHOLD, 0) ?? '',
  pos: formatSigned(T_THRESHOLD, 0) ?? '',
};
const ORDER: VerdictCode[] = ['insufficient', 'not-computable', 'loss-clear', 'gain-clear', 'no-difference'];
const rule = ORDER.map((code) => ({ condition: fmt(x.conditions[code], thresholds), verdict: t.verdict[code] }));

const jsonLd = breadcrumbLd(locale, [
  { name: c.breadcrumb.home, path: '/' },
  { name: t.crumb, path: PATH },
]);
---

<Base locale={locale} path={PATH} title={x.title} description={x.description} jsonLd={jsonLd}>
  <section class="read">
    <div class="wrap">
      <h1 class="head">{head}</h1>
      <p class="sub">{x.sub}</p>
      <Cta
        locale={locale}
        pageType="backtest"
        position="hero"
        primary={{ label: x.primary, href: localePath(locale, '/bot/#quickstart') }}
        secondary={{ label: x.secondary, href: REPO_URL }}
      />
    </div>
  </section>

  <section class="verdict">
    <div class="wrap">
      <h2 class="section-head">{x.tableHead}</h2>
      <div class="tw">
        <table>
          <thead>
            <tr>
              <th scope="col" class="pin">{t.columns.sample}</th>
              <th scope="col">{t.columns.trades}</th>
              <th scope="col">{t.columns.winRate}</th>
              <th scope="col">{t.columns.avgR}</th>
              <th scope="col">{t.columns.t}</th>
              <th scope="col">{t.columns.maxDrawdown}</th>
              <th scope="col" class="l">{t.columns.verdict}</th>
            </tr>
          </thead>
          {
            groups.map((group) => (
              <tbody>
                <tr class="group">
                  <th scope="rowgroup" colspan="7">
                    <span class="name">
                      <a class="lnk" href={group.href}>
                        {group.name}
                      </a>
                      <span class="num">{group.market}</span>
                    </span>
                  </th>
                </tr>
                {group.rows.map((row) => (
                  <tr>
                    <th scope="row" class="pin">
                      {row.sample}
                      <span class="when">
                        <span>{row.rangeLead}</span>{' '}<span>{row.rangeEnd}</span>
                      </span>
                    </th>
                    <td class="num">{row.trades}</td>
                    <td class="num">{row.winRate}</td>
                    <td class="num">{row.avgR}</td>
                    <td class="num">{row.tStat}</td>
                    <td class="num">{row.maxDrawdown}</td>
                    <td class="l">{row.verdict}</td>
                  </tr>
                ))}
              </tbody>
            ))
          }
        </table>
      </div>
      <p class="fine">{caption}</p>
    </div>
  </section>

  <section class="read">
    <div class="wrap rows">
      <div>
        <h2>{x.rHead}</h2>
        <div class="prose">
          <p>{x.rBody}</p>
        </div>
      </div>
      <div id="verdict-rule">
        <h2>{x.ruleHead}</h2>
        <div class="prose">
          <table>
            <thead>
              <tr>
                <th scope="col">{x.condition}</th>
                <th scope="col" class="l">{t.columns.verdict}</th>
              </tr>
            </thead>
            <tbody>
              {
                rule.map((line) => (
                  <tr>
                    <td>{line.condition}</td>
                    <td class="l">{line.verdict}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
      <div>
        <h2>{x.tHead}</h2>
        <div class="prose">
          <p>{x.tBody}</p>
        </div>
      </div>
    </div>
  </section>

  <style>
    .tw {
      margin-top: var(--space-lg);
    }

    .l {
      text-align: left;
    }

    .verdict th,
    .verdict td {
      vertical-align: top;
      white-space: nowrap;
    }

    /* The sample name stays in view while the figures scroll sideways, and so
       does the strategy name in the row above each pair. */
    .verdict .pin {
      position: sticky;
      left: 0;
      background: var(--color-ink);
    }

    .group th {
      padding-block: var(--space-md) 0;
      border-bottom: 0;
    }

    .group .name {
      position: sticky;
      left: var(--space-xs);
      display: inline-flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0 var(--space-md);
      font-weight: 400;
    }

    .group .lnk {
      font-size: var(--text-lg);
      font-weight: 800;
    }

    .when {
      display: block;
      font-weight: 400;
      font-variant-numeric: tabular-nums;
    }

    .when span {
      white-space: nowrap;
    }

    @media (max-width: 760px) {
      /* Two lines for the dates, so the figures get the room. */
      .when span {
        display: block;
      }
    }

    /* The rule table sits in a text column: keep it a table, let it wrap. */
    .prose table {
      display: table;
    }
  </style>
</Base>
