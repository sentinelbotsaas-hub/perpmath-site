---
// /backtests/: every published backtest on one page. Four summary figures,
// then one card per result with in-sample and out-of-sample side by side,
// then how to read the numbers.
//
// There are two kinds of result. The signal strategies come first, each with
// a verdict. A grid backtest gets a section of its own, with the conditions
// it has to be read with printed beside its card: a grid that gained while
// price stayed in its range is not shown as if it were a strategy that works.
//
// The cards are read from src/data/backtests/*.json; nothing is typed in, and
// the summary figures are counted from the same files on this page. The
// headline is chosen by src/lib/backtests/overview.ts from those files. The
// verdict is decided by src/lib/backtests/verdict.ts and the same rule is
// printed under the cards, with its thresholds taken from that file.
// A loss is never shown by colour alone: it is a minus sign and a sentence.
import Cta from '../../../components/Cta.astro';
import GridCard from '../../../components/research/GridCard.astro';
import GridPremises from '../../../components/research/GridPremises.astro';
import StrategyCard from '../../../components/research/StrategyCard.astro';
import { headline } from '../../../components/research/headline';
import DataTable from '../../../components/ui/DataTable.astro';
import MetricCard from '../../../components/ui/MetricCard.astro';
import PageContainer from '../../../components/ui/PageContainer.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import { backtests } from '../../../i18n/backtests';
import { common } from '../../../i18n/common';
import { localePath, localeStaticPaths } from '../../../i18n/config';
import type { Locale } from '../../../i18n/config';
import Base from '../../../layouts/Base.astro';
import { REPO_URL } from '../../../lib/backtests/engine';
import { exclusiveEnd, formatCount, formatDay, formatSigned } from '../../../lib/backtests/format';
import { allResults, gridResults, results } from '../../../lib/backtests/load';
import { MIN_TRADES, T_THRESHOLD } from '../../../lib/backtests/verdict';
import type { VerdictCode } from '../../../lib/backtests/verdict';
import { fmt } from '../../../lib/fmt';
import { breadcrumbLd } from '../../../lib/seo';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = backtests[locale];
const x = t.index;
const c = common[locale];
const PATH = '/backtests/';

if (results.length === 0) throw new Error('backtests: src/data/backtests/ is empty. Run scripts/backtests-import.mjs.');

// The headline, the line under it and the cost captions: one rule for this
// page, the home page and /bot/.
const top = headline(x, t.na);
const { n } = top;
const hasGrid = gridResults.length > 0;
const gridCaption = gridResults.every((r) => r.costs.funding_modelled) ? x.gridCaption : x.gridCaptionPlain;

// --- the four summary figures, counted from the result files ---------------
const sum = (values: number[]) => values.reduce((a, b) => a + b, 0);
const lostOutOfSample = allResults.filter((r) => {
  const value = r.out_of_sample.metrics.total_return_pct;
  return value !== null && value < 0;
}).length;
const tradesIn = sum(results.map((r) => r.in_sample.metrics.trades));
const tradesOut = sum(results.map((r) => r.out_of_sample.metrics.trades));
const gridTrips = sum(gridResults.flatMap((r) => [r.in_sample.metrics.round_trips, r.out_of_sample.metrics.round_trips]));
// The data period: from the earliest first bar to the end of the latest last bar.
const byTime = (a: string, b: string) => Date.parse(a) - Date.parse(b);
const firstBar = allResults.map((r) => r.data.first_bar).sort(byTime)[0];
const lastBar = allResults.map((r) => r.data.last_bar).sort(byTime).at(-1) as string;
const periodEnd = allResults.map((r) => exclusiveEnd(r.data.last_bar, r.interval)).sort(byTime).at(-1) as string;
const days = Math.round((Date.parse(periodEnd) - Date.parse(firstBar)) / 86_400_000);
const markets = [...new Set(allResults.map((r) => `${r.symbol} ${r.interval}`))];

const summary: Array<{ label: string; value: string; unit?: string; note: string }> = [
  hasGrid
    ? {
        label: x.summary.backtests,
        value: n,
        note: fmt(x.summary.backtestsNote, { s: top.s, g: top.g, markets: markets.join(', ') }),
      }
    : { label: x.summary.strategies, value: n, note: markets.join(', ') },
  {
    label: x.summary.oosLost,
    value: `${formatCount(lostOutOfSample)} / ${n}`,
    // The longer note says which one did not lose; it is only true in that one case.
    note: top.code === 'grid-ranged' ? x.summary.oosLostNoteRanged : x.summary.oosLostNote,
  },
  {
    label: x.summary.trades,
    value: formatCount(tradesIn + tradesOut),
    note: hasGrid
      ? fmt(x.summary.tradesNoteGrid, { is: formatCount(tradesIn), oos: formatCount(tradesOut), trips: formatCount(gridTrips) })
      : fmt(x.summary.tradesNote, { is: formatCount(tradesIn), oos: formatCount(tradesOut) }),
  },
  {
    label: x.summary.period,
    value: formatCount(days),
    unit: x.summary.days,
    note: fmt(t.range, { from: formatDay(firstBar), to: formatDay(lastBar) }),
  },
];

// The rule, in the order verdict.ts checks it.
const thresholds = {
  min: formatCount(MIN_TRADES),
  neg: formatSigned(-T_THRESHOLD, 0) ?? '',
  pos: formatSigned(T_THRESHOLD, 0) ?? '',
};
const ORDER: VerdictCode[] = ['insufficient', 'not-computable', 'loss-clear', 'gain-clear', 'no-difference'];
const rule = ORDER.map((code) => ({ condition: fmt(x.conditions[code], thresholds), verdict: t.verdict[code] }));

const trail = [
  { name: c.breadcrumb.home, path: '/' },
  { name: t.crumb, path: PATH },
];
const jsonLd = breadcrumbLd(locale, trail);
---

<Base locale={locale} path={PATH} title={x.title} description={x.description} jsonLd={jsonLd}>
  <PageContainer lead>
    <PageHeader locale={locale} title={top.head} lede={top.sub} breadcrumb={trail}>
      <Cta
        locale={locale}
        pageType="backtest"
        position="hero"
        primary={{ label: x.primary, href: localePath(locale, '/bot/#quickstart') }}
        secondary={{ label: x.secondary, href: REPO_URL }}
      />
    </PageHeader>
    <div class="cards cols-4 bt-summary" role="group" aria-label={x.summary.label}>
      {summary.map((item) => <MetricCard label={item.label} value={item.value} unit={item.unit} note={item.note} />)}
    </div>
  </PageContainer>

  <PageContainer flush id="signal-strategies">
    <SectionHeader title={hasGrid ? x.signalsHead : x.tableHead} desc={top.strategyCaption} />
    <div class="bt-grid">
      {results.map((result) => <StrategyCard locale={locale} result={result} />)}
    </div>
  </PageContainer>

  {
    hasGrid && (
      <PageContainer flush id="grid">
        <SectionHeader title={x.gridHead} desc={gridCaption} />
        <div class="bt-grids">
          {gridResults.map((result) => (
            <div class="bt-grid-pair">
              <GridCard locale={locale} result={result} />
              <GridPremises locale={locale} result={result} compact />
            </div>
          ))}
        </div>
      </PageContainer>
    )
  }

  <PageContainer band>
    <SectionHeader title={x.readHead} />
    <div class="bt-read">
      <div id="verdict-rule">
        <h3 class="h-card">{x.ruleHead}</h3>
        <DataTable locale={locale} label={x.ruleHead} class="bt-on-surface">
          <thead>
            <tr>
              <th scope="col">{x.condition}</th>
              <th scope="col" class="bt-l">{t.columns.verdict}</th>
            </tr>
          </thead>
          <tbody>
            {
              rule.map((line) => (
                <tr>
                  <td>{line.condition}</td>
                  <td class="bt-l">{line.verdict}</td>
                </tr>
              ))
            }
          </tbody>
        </DataTable>
      </div>
      <div class="bt-defs">
        <div>
          <h3 class="h-card">{x.rHead}</h3>
          <p>{x.rBody}</p>
        </div>
        <div>
          <h3 class="h-card">{x.tHead}</h3>
          <p>{x.tBody}</p>
        </div>
        {
          hasGrid && (
            <div>
              <h3 class="h-card">{x.gridWhyHead}</h3>
              <p>{x.gridWhyBody}</p>
            </div>
          )
        }
      </div>
    </div>
  </PageContainer>
</Base>

<style>
  .bt-summary {
    margin-top: var(--space-12);
  }

  /* One card a strategy. Each holds a three-column table, so a card is never
     narrower than that table: two across from 860px, three from 1260px. */
  .bt-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 860px) {
    .bt-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1260px) {
    .bt-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* A grid result and, beside it, what it has to be read with. */
  .bt-grids {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
  }

  .bt-grid-pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }

  @media (min-width: 860px) {
    .bt-grid-pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* On the three-column grid of the cards above: the card takes one column,
     the conditions the other two. */
  @media (min-width: 1260px) {
    .bt-grid-pair {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .bt-grid-pair > :global(.note) {
      grid-column: span 2;
    }
  }

  /* The rule on the left, the definitions it relies on beside it. */
  .bt-read {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-10);
    align-items: start;
  }

  .bt-read h3 {
    margin-bottom: var(--space-3);
  }

  .bt-defs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
  }

  .bt-defs p {
    max-width: 52ch;
    color: var(--color-text-secondary);
  }

  .bt-l {
    text-align: left;
    white-space: normal;
  }

  @media (max-width: 860px) {
    .bt-read {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
