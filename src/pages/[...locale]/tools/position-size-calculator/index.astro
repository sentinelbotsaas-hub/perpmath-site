---
// Position size calculator. One file serves all three locales.
// The interactive part is src/scripts/position-size-calculator.ts; everything
// on this page is also correct with scripting off (it shows worked example 1).
import Cta from '../../../../components/Cta.astro';
import Field from '../../../../components/Field.astro';
import CalculatorShell from '../../../../components/calc/CalculatorShell.astro';
import DocSection from '../../../../components/calc/DocSection.astro';
import ExampleBlock from '../../../../components/calc/ExampleBlock.astro';
import RelatedTools from '../../../../components/calc/RelatedTools.astro';
import ResultFlag from '../../../../components/calc/ResultFlag.astro';
import ScaleBars from '../../../../components/calc/ScaleBars.astro';
import SliderField from '../../../../components/calc/SliderField.astro';
import { splitFigure } from '../../../../components/calc/calc-ui';
import { ASSUMED_FEE_PCT, POSITION_START } from '../../../../components/calc/starting-values';
import Accordion from '../../../../components/ui/Accordion.astro';
import DataFreshness from '../../../../components/ui/DataFreshness.astro';
import Disclaimer from '../../../../components/ui/Disclaimer.astro';
import FormulaBlock from '../../../../components/ui/FormulaBlock.astro';
import Meter from '../../../../components/ui/Meter.astro';
import PageContainer from '../../../../components/ui/PageContainer.astro';
import PageHeader from '../../../../components/ui/PageHeader.astro';
import { common } from '../../../../i18n/common';
import { localeStaticPaths } from '../../../../i18n/config';
import type { Locale } from '../../../../i18n/config';
import { positionSize as strings } from '../../../../i18n/position-size';
import { calc } from '../../../../i18n/tools';
import Base from '../../../../layouts/Base.astro';
import { floorTo, maxLeverage } from '../../../../lib/calc/leverage';
import { roundToTick } from '../../../../lib/calc/liquidation';
import { positionSize } from '../../../../lib/calc/position-size';
import { fmt, formatNumber, formatPercent, tickDecimals } from '../../../../lib/fmt';
import { BTCUSDT, snapshotDate, tierOne } from '../../../../lib/risk-limit';
import { breadcrumbLd, softwareApplicationLd } from '../../../../lib/seo';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings[locale];
const c = common[locale];
const ui = calc[locale];
const PATH = '/tools/position-size-calculator/';

// Exchange parameters come from the snapshot, never from a constant here.
const tier = tierOne(BTCUSDT);
const mmr = tier.maintenanceMargin;
const cap = tier.maxLeverage;
const tick = BTCUSDT.tickSize;
const decimals = tickDecimals(tick);
const date = snapshotDate(BTCUSDT);
const limit = formatNumber(tier.riskLimitValue);
const mmrPct = formatPercent(mmr);

// The one assumption on this page is the fee per side (ASSUMED_FEE_PCT, in
// percent). It is shown next to its field as an assumption and the reader
// can change it.
const feePct = formatPercent(ASSUMED_FEE_PCT / 100, 3);

const price = (n: number) => formatNumber(roundToTick(n, tick), decimals);
const typed = (n: number) => formatNumber(n, Number.isInteger(n) ? 0 : decimals);
const money = (n: number) => formatNumber(n, 2);
const quantity = (n: number) => formatNumber(floorTo(n, 4), 4);

// One worked example: everything shown is computed by the calc library.
function solve(account: number, riskPct: number, entry: number, stop: number, lev: number) {
  const r = positionSize({
    accountSize: account,
    riskFraction: riskPct / 100,
    entryPrice: entry,
    stopPrice: stop,
    leverage: lev,
    feeRate: ASSUMED_FEE_PCT / 100,
    mmr,
    maxLeverage: cap,
  });
  if (!r.ok) throw new Error('Worked example is invalid');
  const fix = maxLeverage({ side: r.side, entryPrice: entry, stopPrice: stop, mmr, maxLeverage: cap });
  if (!fix.ok || !fix.feasible) throw new Error('Worked example is invalid');
  const vars = {
    account: formatNumber(account),
    risk: formatPercent(riskPct / 100),
    entry: formatNumber(entry),
    stop: typed(stop),
    lev,
    fee: feePct,
    amount: money(r.riskAmount),
    qty: quantity(r.quantity),
    notional: money(r.notional),
    margin: money(r.margin),
    feeAmount: money(r.roundTripFee),
    liq: price(r.liquidationPrice),
    max: fix.maxWholeLeverage,
    pct: formatPercent(riskPct / 100),
  };
  return { account, riskPct, entry, stop, lev, r, vars };
}

function example(title: string, s: ReturnType<typeof solve>) {
  const lines = [
    t.examples.workRisk,
    t.examples.workQuantity,
    t.examples.workNotional,
    t.examples.workMargin,
    t.examples.workFee,
    t.examples.workLiq,
  ];
  return {
    title: fmt(title, s.vars),
    setup: fmt(s.r.side === 'long' ? t.examples.setupLong : t.examples.setupShort, s.vars),
    working: lines.map((line) => fmt(line, s.vars)).join('\n'),
    result: fmt(s.r.stopBeforeLiquidation ? t.examples.resultOk : t.examples.resultLiquidated, s.vars),
  };
}

// Example 1 is also the starting state, and what a reader without JavaScript sees.
const first = solve(POSITION_START.account, POSITION_START.riskPct, POSITION_START.entry, POSITION_START.stop, POSITION_START.lev);
const second = solve(4000, 2, 68000, 72000, 25);
if (!first.r.stopBeforeLiquidation || second.r.stopBeforeLiquidation) throw new Error('Worked examples changed meaning');
const ex1 = example(t.examples.first, first);
const ex2 = example(t.examples.second, second);

const start = first.r;
const startStopPct = formatPercent(start.stopDistance);
const startLiqPct = formatPercent(start.liquidationDistance);
const usdt = (n: number) => fmt(t.ui.usdt, { value: money(n) });
const startFigure = splitFigure(fmt(t.ui.figure, { qty: first.vars.qty }));

const termVars = { fee: feePct };
const checkVars = { mmr: mmrPct, date };

// Plain data for the browser script.
const calcData = JSON.stringify({ tick, maxLeverage: cap, tierLimit: tier.riskLimitValue, mmr, strings: t.ui });

// The same trail for the visible breadcrumb and for JSON-LD.
const trail = [
  { name: c.breadcrumb.home, path: '/' },
  { name: c.nav.tools, path: '/tools/' },
  { name: t.title, path: PATH },
];
const jsonLd = [softwareApplicationLd(locale, { path: PATH, name: t.title, description: t.description }), breadcrumbLd(locale, trail)];
---

<Base locale={locale} path={PATH} title={t.title} description={t.description} jsonLd={jsonLd}>
  <PageContainer lead>
    <PageHeader locale={locale} title={t.title} lede={t.lede} breadcrumb={trail}>
      <nav class="calc-jump" aria-label={ui.onThisPage}>
        <a class="lnk" href="#how-it-is-calculated">{t.toc.formula}</a>
        <a class="lnk" href="#worked-examples">{t.toc.examples}</a>
        <a class="lnk" href="#common-mistakes">{t.toc.mistakes}</a>
      </nav>
    </PageHeader>

    <CalculatorShell
      locale={locale}
      data={calcData}
      label={t.result.label}
      figure={startFigure.value}
      unit={startFigure.unit}
      tightUnit={startFigure.tight}
      sentence={fmt(start.side === 'long' ? t.ui.long : t.ui.short, {
        qty: first.vars.qty,
        stop: first.vars.stop,
        amount: first.vars.amount,
        pct: first.vars.pct,
        fee: first.vars.feeAmount,
      })}
    >
      <Fragment slot="inputs">
        <Field id="account" label={t.fields.account} unit="USDT" value={first.account} />
        <Field id="risk" label={t.fields.risk} unit="%" value={first.riskPct} />
        <Field id="entry" label={t.fields.entry} unit="USDT" value={first.entry} />
        <Field id="stop" label={t.fields.stop} unit="USDT" value={first.stop} hint={t.fields.stopHint} />
        <SliderField
          id="lev"
          class="calc-wide"
          label={t.fields.leverage}
          unit={t.fields.leverageUnit}
          value={first.lev}
          min={1}
          max={cap}
          sliderLabel={fmt(ui.slider, { label: t.fields.leverage })}
          valueText={t.ui.levText}
          minText={fmt(t.ui.levText, { value: 1 })}
          maxText={fmt(t.ui.levText, { value: cap })}
        />
        <Accordion summary={ui.advanced} id="calc-advanced">
          <div class="calc-fields">
            <Field
              id="fee"
              class="calc-wide"
              label={t.fields.fee}
              unit="%"
              value={ASSUMED_FEE_PCT}
              hint={fmt(t.fields.feeHint, { fee: feePct })}
            />
          </div>
        </Accordion>
      </Fragment>

      <Fragment slot="after-inputs">
        <noscript><p class="fine">{t.noscript}</p></noscript>
      </Fragment>

      <Fragment slot="flags">
        <ResultFlag id="calc-margin-note" text={t.ui.marginNote} />
        <ResultFlag id="calc-tier" />
      </Fragment>

      <ScaleBars
        slot="viz"
        id="calc-bars"
        a={start.stopDistance}
        b={start.liquidationDistance}
        aLabel={t.ui.stopBar}
        aValue={startStopPct}
        bLabel={fmt(t.ui.liqBar, { lev: first.lev })}
        bValue={startLiqPct}
        bTone="negative"
        caption={(layout) => fmt(t.ui.barLabel, { max: layout.maxLabel, stop: startStopPct, lev: first.lev, liq: startLiqPct })}
      />

      <Fragment slot="metrics">
        <table class="calc-kv">
          <caption class="visually-hidden">{t.result.caption}</caption>
          <tbody>
            <tr>
              <th scope="row">{t.result.notional}</th>
              <td class="num" id="out-notional">{usdt(start.notional)}</td>
            </tr>
            <tr>
              <th scope="row">{t.result.margin}</th>
              <td class="num" id="out-margin">{usdt(start.margin)}</td>
            </tr>
            <tr>
              <th scope="row">{t.result.fee}</th>
              <td class="num" id="out-fee">{usdt(start.roundTripFee)}</td>
            </tr>
            <tr>
              <th scope="row">{t.result.loss}</th>
              <td class="num" id="out-loss">{usdt(start.lossAtStop)}</td>
            </tr>
            <tr>
              <th scope="row" id="out-liq-label">{fmt(t.ui.liqRow, { lev: first.lev })}</th>
              <td class="num" id="out-liq">{price(start.liquidationPrice)}</td>
            </tr>
          </tbody>
        </table>
        {/* The margin as a share of the account: the bar's full width is the account. */}
        <div class="calc-share">
          <div class="calc-share-ends" aria-hidden="true">
            <span>{t.result.margin} <span class="num" id="out-margin-share">{usdt(start.margin)}</span></span>
            <span>{t.fields.account} <span class="num" id="out-account">{usdt(first.account)}</span></span>
          </div>
          <Meter
            id="calc-margin-meter"
            size="tall"
            value={start.margin / first.account}
            label={fmt(t.ui.marginMeter, { margin: money(start.margin), account: money(first.account) })}
          />
        </div>
      </Fragment>

      <Fragment slot="assumptions">
        <ul class="calc-assume">
          <li>{fmt(t.assumption, { mmr: mmrPct, limit, date })}</li>
          {t.assumptions.map((line) => <li>{fmt(line, { fee: feePct })}</li>)}
          <li>{c.ui.estimate}</li>
        </ul>
        <DataFreshness locale={locale} date={date} source={ui.source} />
      </Fragment>

      <Cta
        slot="cta"
        locale={locale}
        pageType="tool"
        position="result"
        primary={{ label: c.cta.testnet, exit: 'bybit-testnet' }}
        secondary={{ label: c.cta.liveAccount, exit: 'bybit' }}
      />
    </CalculatorShell>
  </PageContainer>

  <DocSection id="how-it-is-calculated" title={t.toc.formula}>
    <p>{t.formula.intro}</p>
    <FormulaBlock formula={t.formula.lines.join('\n')} />
    <dl class="calc-terms">
      {
        t.formula.terms.map((item) => (
          <div>
            <dt>{item.term}</dt>
            <dd>{fmt(item.text, termVars)}</dd>
          </div>
        ))
      }
    </dl>
    <p>{fmt(t.formula.check, checkVars)}</p>
    <Disclaimer locale={locale} kind="info" title={ui.leftOut}>
      <p>{t.formula.leftOut}</p>
    </Disclaimer>
  </DocSection>

  <DocSection id="worked-examples" title={t.toc.examples}>
    <div class="calc-pair">
      {[ex1, ex2].map((ex) => <ExampleBlock title={ex.title} setup={ex.setup} working={ex.working} result={ex.result} />)}
    </div>
  </DocSection>

  <DocSection id="common-mistakes" title={t.toc.mistakes}>
    <ul class="calc-mistakes">
      {
        t.mistakes.map((m) => (
          <li>
            <h3>{m.title}</h3>
            <p>{fmt(m.text, first.vars)}</p>
          </li>
        ))
      }
    </ul>
  </DocSection>

  <RelatedTools locale={locale} current="position-size-calculator" allLabel={t.allTools} />

  <script>
    import '../../../../scripts/position-size-calculator.ts';
  </script>
</Base>
