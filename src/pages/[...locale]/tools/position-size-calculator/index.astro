---
// Position size calculator. One file serves all three locales.
// The interactive part is src/scripts/position-size-calculator.ts; everything
// on this page is also correct with scripting off (it shows worked example 1).
import Cta from '../../../../components/Cta.astro';
import Field from '../../../../components/Field.astro';
import Verdict from '../../../../components/Verdict.astro';
import { common } from '../../../../i18n/common';
import { localePath, localeStaticPaths } from '../../../../i18n/config';
import type { Locale } from '../../../../i18n/config';
import { positionSize as strings } from '../../../../i18n/position-size';
import Base from '../../../../layouts/Base.astro';
import { floorTo, maxLeverage } from '../../../../lib/calc/leverage';
import { roundToTick } from '../../../../lib/calc/liquidation';
import { positionSize } from '../../../../lib/calc/position-size';
import { fmt, formatNumber, formatPercent, tickDecimals } from '../../../../lib/fmt';
import { BTCUSDT, snapshotDate, tierOne } from '../../../../lib/risk-limit';
import { breadcrumbLd, softwareApplicationLd } from '../../../../lib/seo';
import { getTool } from '../../../../lib/tools';
import Lanes from '../_parts/Lanes.astro';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings[locale];
const c = common[locale];
const PATH = '/tools/position-size-calculator/';

// Exchange parameters come from the snapshot, never from a constant here.
const tier = tierOne(BTCUSDT);
const mmr = tier.maintenanceMargin;
const cap = tier.maxLeverage;
const tick = BTCUSDT.tickSize;
const decimals = tickDecimals(tick);
const date = snapshotDate(BTCUSDT);
const limit = formatNumber(tier.riskLimitValue);
const mmrPct = formatPercent(mmr);

// The one assumption on this page: the fee per side, in percent. It is shown
// next to its field as an assumption and the reader can change it.
const ASSUMED_FEE_PCT = 0.055;
const feePct = formatPercent(ASSUMED_FEE_PCT / 100, 3);

const price = (n: number) => formatNumber(roundToTick(n, tick), decimals);
const typed = (n: number) => formatNumber(n, Number.isInteger(n) ? 0 : decimals);
const money = (n: number) => formatNumber(n, 2);
const quantity = (n: number) => formatNumber(floorTo(n, 4), 4);

// One worked example: everything shown is computed by the calc library.
function solve(account: number, riskPct: number, entry: number, stop: number, lev: number) {
  const r = positionSize({
    accountSize: account,
    riskFraction: riskPct / 100,
    entryPrice: entry,
    stopPrice: stop,
    leverage: lev,
    feeRate: ASSUMED_FEE_PCT / 100,
    mmr,
    maxLeverage: cap,
  });
  if (!r.ok) throw new Error('Worked example is invalid');
  const fix = maxLeverage({ side: r.side, entryPrice: entry, stopPrice: stop, mmr, maxLeverage: cap });
  if (!fix.ok || !fix.feasible) throw new Error('Worked example is invalid');
  const vars = {
    account: formatNumber(account),
    risk: formatPercent(riskPct / 100),
    entry: formatNumber(entry),
    stop: typed(stop),
    lev,
    fee: feePct,
    amount: money(r.riskAmount),
    qty: quantity(r.quantity),
    notional: money(r.notional),
    margin: money(r.margin),
    feeAmount: money(r.roundTripFee),
    liq: price(r.liquidationPrice),
    max: fix.maxWholeLeverage,
    pct: formatPercent(riskPct / 100),
  };
  return { account, riskPct, entry, stop, lev, r, vars };
}

function example(title: string, s: ReturnType<typeof solve>) {
  const lines = [
    t.examples.workRisk,
    t.examples.workQuantity,
    t.examples.workNotional,
    t.examples.workMargin,
    t.examples.workFee,
    t.examples.workLiq,
  ];
  return {
    title: fmt(title, s.vars),
    setup: fmt(s.r.side === 'long' ? t.examples.setupLong : t.examples.setupShort, s.vars),
    working: lines.map((line) => fmt(line, s.vars)).join('\n'),
    result: fmt(s.r.stopBeforeLiquidation ? t.examples.resultOk : t.examples.resultLiquidated, s.vars),
  };
}

// Example 1 is also the starting state, and what a reader without JavaScript sees.
const first = solve(10000, 1, 68000, 66400, 10);
const second = solve(4000, 2, 68000, 72000, 25);
if (!first.r.stopBeforeLiquidation || second.r.stopBeforeLiquidation) throw new Error('Worked examples changed meaning');
const ex1 = example(t.examples.first, first);
const ex2 = example(t.examples.second, second);

const start = first.r;
const startStopPct = formatPercent(start.stopDistance);
const startLiqPct = formatPercent(start.liquidationDistance);
const usdt = (n: number) => fmt(t.ui.usdt, { value: money(n) });

const termVars = { fee: feePct };
const checkVars = { mmr: mmrPct, date };

// Plain data for the browser script.
const calcData = JSON.stringify({ tick, maxLeverage: cap, tierLimit: tier.riskLimitValue, mmr, strings: t.ui });

const leverageTool = getTool(locale, 'leverage-calculator');
const liquidationTool = getTool(locale, 'liquidation-price-calculator');

const jsonLd = [
  softwareApplicationLd(locale, { path: PATH, name: t.title, description: t.description }),
  breadcrumbLd(locale, [
    { name: c.breadcrumb.home, path: '/' },
    { name: c.nav.tools, path: '/tools/' },
    { name: t.title, path: PATH },
  ]),
];
---

<Base locale={locale} path={PATH} title={t.title} description={t.description} surface="measure" jsonLd={jsonLd}>
  <section class="measure" data-calc={calcData}>
    <div class="wrap">
      <h1 class="head">{t.title}</h1>
      <p class="sub">{t.lede}</p>

      <div class="sticky-scale">
        <Lanes
          id="calc-scale"
          top={start.stopDistance}
          bottom={start.liquidationDistance}
          label={fmt(t.ui.barLabel, { stop: startStopPct, lev: first.lev, liq: startLiqPct })}
          topText={fmt(t.ui.stopLane, { pct: startStopPct })}
          bottomText={fmt(t.ui.liqLane, { lev: first.lev, pct: startLiqPct })}
          endText={fmt(t.ui.entry, { price: formatNumber(first.entry) })}
        />
      </div>

      <form class="fields" id="calc-form" novalidate>
        <Field id="account" label={t.fields.account} unit="USDT" value={first.account} />
        <Field id="risk" label={t.fields.risk} unit="%" value={first.riskPct} />
        <Field id="entry" label={t.fields.entry} unit="USDT" value={first.entry} />
        <Field id="stop" label={t.fields.stop} unit="USDT" value={first.stop} hint={t.fields.stopHint} />
        <Field id="lev" label={t.fields.leverage} unit={t.fields.leverageUnit} value={first.lev} />
        <Field id="fee" label={t.fields.fee} unit="%" value={ASSUMED_FEE_PCT} hint={fmt(t.fields.feeHint, { fee: feePct })} />
      </form>
      <p class="fine">{fmt(t.assumption, { mmr: mmrPct, limit, date })}</p>
      <noscript><p class="fine">{t.noscript}</p></noscript>
    </div>
  </section>

  <Verdict
    label={t.result.label}
    figure={fmt(t.ui.figure, { qty: first.vars.qty })}
    sentence={fmt(start.side === 'long' ? t.ui.long : t.ui.short, {
      qty: first.vars.qty,
      stop: first.vars.stop,
      amount: first.vars.amount,
      pct: first.vars.pct,
      fee: first.vars.feeAmount,
    })}
    figureId="calc-figure"
    sentenceId="calc-sentence"
  >
    <div class="tw results">
      <table>
        <caption class="visually-hidden">{t.result.caption}</caption>
        <tbody>
          <tr>
            <th scope="row">{t.result.notional}</th>
            <td class="num" id="out-notional">{usdt(start.notional)}</td>
          </tr>
          <tr>
            <th scope="row">{t.result.margin}</th>
            <td class="num" id="out-margin">{usdt(start.margin)}</td>
          </tr>
          <tr>
            <th scope="row">{t.result.fee}</th>
            <td class="num" id="out-fee">{usdt(start.roundTripFee)}</td>
          </tr>
          <tr>
            <th scope="row">{t.result.loss}</th>
            <td class="num" id="out-loss">{usdt(start.lossAtStop)}</td>
          </tr>
          <tr>
            <th scope="row" id="out-liq-label">{fmt(t.ui.liqRow, { lev: first.lev })}</th>
            <td class="num" id="out-liq">{price(start.liquidationPrice)}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="fine" id="calc-margin-note" hidden>{t.ui.marginNote}</p>
    <p class="fine" id="calc-tier" hidden></p>
    <Cta
      locale={locale}
      pageType="tool"
      position="result"
      primary={{ label: c.cta.testnet, exit: 'bybit-testnet' }}
      secondary={{ label: c.cta.liveAccount, exit: 'bybit' }}
    />
  </Verdict>

  <section class="read">
    <div class="wrap docs">
      <nav class="toc" aria-label={t.title}>
        <a class="lnk" href="#how-it-is-calculated">{t.toc.formula}</a>
        <a class="lnk" href="#worked-examples">{t.toc.examples}</a>
        <a class="lnk" href="#common-mistakes">{t.toc.mistakes}</a>
        {leverageTool.href && <a class="lnk" href={leverageTool.href}>{leverageTool.name}</a>}
        {liquidationTool.href && <a class="lnk" href={liquidationTool.href}>{liquidationTool.name}</a>}
        <a class="lnk" href={localePath(locale, '/tools/')}>{t.allTools}</a>
      </nav>

      <div class="prose">
        <h2 id="how-it-is-calculated">{t.toc.formula}</h2>
        <p>{t.formula.intro}</p>
        <pre>{t.formula.lines.join('\n')}</pre>
        <ul>
          {
            t.formula.terms.map((item) => (
              <li><strong>{item.term}</strong>{locale === 'en' ? ': ' : '：'}{fmt(item.text, termVars)}</li>
            ))
          }
        </ul>
        <p>{fmt(t.formula.check, checkVars)}</p>
        <p>{t.formula.leftOut}</p>

        <h2 id="worked-examples">{t.toc.examples}</h2>
        {
          [ex1, ex2].map((ex) => (
            <>
              <h3>{ex.title}</h3>
              <p>{ex.setup}</p>
              <pre>{ex.working}</pre>
              <p>{ex.result}</p>
            </>
          ))
        }

        <h2 id="common-mistakes">{t.toc.mistakes}</h2>
        {
          t.mistakes.map((m) => (
            <>
              <h3>{m.title}</h3>
              <p>{fmt(m.text, first.vars)}</p>
            </>
          ))
        }
      </div>
    </div>
  </section>

  <style>
    .results {
      max-width: var(--measure);
      margin-top: var(--space-lg);
    }

    .results th {
      font-weight: 400;
    }
  </style>

  <script>
    import '../../../../scripts/position-size-calculator.ts';
  </script>
</Base>
