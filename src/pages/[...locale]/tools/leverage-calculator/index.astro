---
// Leverage calculator. One file serves all three locales.
// The interactive part is src/scripts/leverage-calculator.ts; everything on
// this page is also correct with scripting off (it shows worked example 1).
import Cta from '../../../../components/Cta.astro';
import Field from '../../../../components/Field.astro';
import Segmented from '../../../../components/Segmented.astro';
import CalculatorShell from '../../../../components/calc/CalculatorShell.astro';
import DocSection from '../../../../components/calc/DocSection.astro';
import ExampleBlock from '../../../../components/calc/ExampleBlock.astro';
import Metric from '../../../../components/calc/Metric.astro';
import RelatedTools from '../../../../components/calc/RelatedTools.astro';
import ScaleBars from '../../../../components/calc/ScaleBars.astro';
import { splitFigure } from '../../../../components/calc/calc-ui';
import { LEVERAGE_START } from '../../../../components/calc/starting-values';
import Accordion from '../../../../components/ui/Accordion.astro';
import DataFreshness from '../../../../components/ui/DataFreshness.astro';
import Disclaimer from '../../../../components/ui/Disclaimer.astro';
import FormulaBlock from '../../../../components/ui/FormulaBlock.astro';
import PageContainer from '../../../../components/ui/PageContainer.astro';
import PageHeader from '../../../../components/ui/PageHeader.astro';
import { common } from '../../../../i18n/common';
import { localeStaticPaths } from '../../../../i18n/config';
import type { Locale } from '../../../../i18n/config';
import { leverage } from '../../../../i18n/leverage';
import { calc } from '../../../../i18n/tools';
import Base from '../../../../layouts/Base.astro';
import { maxLeverage } from '../../../../lib/calc/leverage';
import { liquidationPrice, roundToTick } from '../../../../lib/calc/liquidation';
import type { Side } from '../../../../lib/calc/liquidation';
import { fmt, formatNumber, formatPercent, tickDecimals } from '../../../../lib/fmt';
import { BTCUSDT, snapshotDate, tierOne } from '../../../../lib/risk-limit';
import { breadcrumbLd, softwareApplicationLd } from '../../../../lib/seo';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = leverage[locale];
const c = common[locale];
const ui = calc[locale];
const PATH = '/tools/leverage-calculator/';

// Exchange parameters come from the snapshot, never from a constant here.
const tier = tierOne(BTCUSDT);
const mmr = tier.maintenanceMargin;
const cap = tier.maxLeverage;
const tick = BTCUSDT.tickSize;
const decimals = tickDecimals(tick);
const date = snapshotDate(BTCUSDT);
const limit = formatNumber(tier.riskLimitValue);
const mmrPct = formatPercent(mmr);
const price = (n: number) => formatNumber(roundToTick(n, tick), decimals);
const typed = (n: number) => formatNumber(n, Number.isInteger(n) ? 0 : decimals);

// One worked example: everything shown is computed by the calc library.
function solve(side: Side, entry: number, stop: number) {
  const r = maxLeverage({ side, entryPrice: entry, stopPrice: stop, mmr, maxLeverage: cap });
  if (!r.ok || !r.feasible || r.cappedByExchange) throw new Error('Worked example is invalid');
  const next = r.maxWholeLeverage + 1;
  const above = liquidationPrice({ side, entryPrice: entry, leverage: next, mmr, maxLeverage: next });
  if (!above.ok) throw new Error('Worked example is invalid');
  return { side, entry, stop, r, next, liqNext: above.liquidationPrice };
}

function example(title: string, s: ReturnType<typeof solve>) {
  const pct = formatPercent(s.r.stopDistance);
  const vars = {
    entry: formatNumber(s.entry),
    stop: typed(s.stop),
    mmr: mmrPct,
    m: mmrPct,
    d: pct,
    pct,
    limit: s.r.limit.toFixed(2),
    lev: s.r.maxWholeLeverage,
    next: s.next,
    liq: price(s.r.liquidationPrice),
    liqNext: price(s.liqNext),
  };
  return {
    title: fmt(title, vars),
    setup: fmt(s.side === 'long' ? t.examples.setupLong : t.examples.setupShort, vars),
    working: [t.examples.workDistance, t.examples.workLimit, t.examples.workAt].map((line) => fmt(line, vars)).join('\n'),
    result: fmt(s.side === 'long' ? t.examples.resultLong : t.examples.resultShort, vars),
  };
}

// Example 1 is also the starting state, and what a reader without JavaScript sees.
const first = solve(LEVERAGE_START.side, LEVERAGE_START.entry, LEVERAGE_START.stop);
const second = solve('short', 68000, 69360);
const ex1 = example(t.examples.first, first);
const ex2 = example(t.examples.second, second);

const start = first.r;
const startStopPct = formatPercent(start.stopDistance);
const startLiqPct = formatPercent(start.liquidationDistance);
const startLev = start.maxWholeLeverage;
const startFigure = splitFigure(fmt(t.ui.figure, { lev: startLev }));

const termVars = { mmr: mmrPct, limit, date };
const mistakeVars = {
  pct: startStopPct,
  naive: (1 / start.stopDistance).toFixed(0),
  mmr: mmrPct,
  limit: start.limit.toFixed(2),
};

// Plain data for the browser script.
const calcData = JSON.stringify({ tick, maxLeverage: cap, strings: t.ui });

// The same trail for the visible breadcrumb and for JSON-LD.
const trail = [
  { name: c.breadcrumb.home, path: '/' },
  { name: c.nav.tools, path: '/tools/' },
  { name: t.title, path: PATH },
];
const jsonLd = [softwareApplicationLd(locale, { path: PATH, name: t.title, description: t.description }), breadcrumbLd(locale, trail)];
---

<Base locale={locale} path={PATH} title={t.title} description={t.description} jsonLd={jsonLd}>
  <PageContainer lead>
    <PageHeader locale={locale} title={t.title} lede={t.lede} breadcrumb={trail}>
      <nav class="calc-jump" aria-label={ui.onThisPage}>
        <a class="lnk" href="#how-it-is-calculated">{t.toc.formula}</a>
        <a class="lnk" href="#worked-examples">{t.toc.examples}</a>
        <a class="lnk" href="#common-mistakes">{t.toc.mistakes}</a>
      </nav>
    </PageHeader>

    <CalculatorShell
      locale={locale}
      data={calcData}
      label={t.result.label}
      figure={startFigure.value}
      unit={startFigure.unit}
      tightUnit={startFigure.tight}
      sentence={fmt(t.ui.ok, { lev: startLev, stop: typed(first.stop), liq: price(start.liquidationPrice) })}
    >
      <Fragment slot="inputs">
        <Segmented
          name="side"
          class="calc-wide"
          label={t.fields.side}
          value={first.side}
          options={[
            { value: 'long', label: t.fields.long },
            { value: 'short', label: t.fields.short },
          ]}
        />
        <Field id="entry" label={t.fields.entry} unit="USDT" value={first.entry} />
        <Field id="stop" label={t.fields.stop} unit="USDT" value={first.stop} />
        <Accordion summary={ui.advanced} id="calc-advanced">
          <div class="calc-fields">
            <Field
              id="mmr"
              class="calc-wide"
              label={t.fields.mmr}
              unit="%"
              value={Number((mmr * 100).toFixed(4))}
              hint={fmt(t.fields.mmrHint, { limit, date })}
            />
          </div>
        </Accordion>
      </Fragment>

      <Fragment slot="after-inputs">
        <noscript><p class="fine">{fmt(t.noscript, { pct: startStopPct })}</p></noscript>
      </Fragment>

      <p slot="flags" class="calc-fine" id="calc-note">
        {fmt(t.ui.limit, { stop: startStopPct, mmr: mmrPct, limit: start.limit.toFixed(2) })}
      </p>

      <ScaleBars
        slot="viz"
        id="calc-bars"
        a={start.stopDistance}
        b={start.liquidationDistance}
        aLabel={t.ui.stopBar}
        aValue={startStopPct}
        bLabel={fmt(t.ui.liqBar, { lev: startLev })}
        bValue={startLiqPct}
        bTone="negative"
        caption={(layout) => fmt(t.ui.barLabel, { max: layout.maxLabel, stop: startStopPct, lev: startLev, liq: startLiqPct })}
      />

      <div slot="metrics" class="calc-metrics">
        <Metric
          label={fmt(t.ui.liqRow, { lev: startLev })}
          labelId="out-liq-label"
          value={price(start.liquidationPrice)}
          unit="USDT"
          valueId="out-liq"
        />
        <Metric label={t.result.limit} value={fmt(t.ui.figure, { lev: start.limit.toFixed(2) })} valueId="out-limit" />
      </div>

      <Fragment slot="assumptions">
        <ul class="calc-assume">
          {t.assumptions.map((line) => <li>{fmt(line, { mmr: mmrPct, limit })}</li>)}
          <li>{c.ui.estimate}</li>
        </ul>
        <DataFreshness locale={locale} date={date} source={ui.source} />
      </Fragment>

      <Cta
        slot="cta"
        locale={locale}
        pageType="tool"
        position="result"
        primary={{ label: c.cta.testnet, exit: 'bybit-testnet' }}
        secondary={{ label: c.cta.liveAccount, exit: 'bybit' }}
      />
    </CalculatorShell>
  </PageContainer>

  <DocSection id="how-it-is-calculated" title={t.toc.formula}>
    <p>{t.formula.intro}</p>
    <FormulaBlock formula={t.formula.distance + '\n' + t.formula.limit} />
    <dl class="calc-terms">
      {
        t.formula.terms.map((item) => (
          <div>
            <dt>{item.term}</dt>
            <dd>{fmt(item.text, termVars)}</dd>
          </div>
        ))
      }
    </dl>
    <p>{t.formula.why}</p>
    <p>{fmt(t.formula.whole, { max: cap })}</p>
    <Disclaimer locale={locale} kind="info" title={ui.leftOut}>
      <p>{t.formula.leftOut}</p>
    </Disclaimer>
  </DocSection>

  <DocSection id="worked-examples" title={t.toc.examples}>
    <div class="calc-pair">
      {[ex1, ex2].map((ex) => <ExampleBlock title={ex.title} setup={ex.setup} working={ex.working} result={ex.result} />)}
    </div>
  </DocSection>

  <DocSection id="common-mistakes" title={t.toc.mistakes}>
    <ul class="calc-mistakes">
      {
        t.mistakes.map((m) => (
          <li>
            <h3>{m.title}</h3>
            <p>{fmt(m.text, mistakeVars)}</p>
          </li>
        ))
      }
    </ul>
  </DocSection>

  <RelatedTools locale={locale} current="leverage-calculator" allLabel={t.allTools} />

  <script>
    import '../../../../scripts/leverage-calculator.ts';
  </script>
</Base>
