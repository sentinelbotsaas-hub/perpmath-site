---
// Leverage calculator. One file serves all three locales.
// The interactive part is src/scripts/leverage-calculator.ts; everything on
// this page is also correct with scripting off (it shows worked example 1).
import Cta from '../../../../components/Cta.astro';
import Field from '../../../../components/Field.astro';
import Segmented from '../../../../components/Segmented.astro';
import Verdict from '../../../../components/Verdict.astro';
import { common } from '../../../../i18n/common';
import { localePath, localeStaticPaths } from '../../../../i18n/config';
import type { Locale } from '../../../../i18n/config';
import { leverage } from '../../../../i18n/leverage';
import Base from '../../../../layouts/Base.astro';
import { maxLeverage } from '../../../../lib/calc/leverage';
import { liquidationPrice, roundToTick } from '../../../../lib/calc/liquidation';
import type { Side } from '../../../../lib/calc/liquidation';
import { fmt, formatNumber, formatPercent, tickDecimals } from '../../../../lib/fmt';
import { BTCUSDT, snapshotDate, tierOne } from '../../../../lib/risk-limit';
import { breadcrumbLd, softwareApplicationLd } from '../../../../lib/seo';
import { getTool } from '../../../../lib/tools';
import Lanes from '../_parts/Lanes.astro';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = leverage[locale];
const c = common[locale];
const PATH = '/tools/leverage-calculator/';

// Exchange parameters come from the snapshot, never from a constant here.
const tier = tierOne(BTCUSDT);
const mmr = tier.maintenanceMargin;
const cap = tier.maxLeverage;
const tick = BTCUSDT.tickSize;
const decimals = tickDecimals(tick);
const date = snapshotDate(BTCUSDT);
const limit = formatNumber(tier.riskLimitValue);
const mmrPct = formatPercent(mmr);
const price = (n: number) => formatNumber(roundToTick(n, tick), decimals);
const typed = (n: number) => formatNumber(n, Number.isInteger(n) ? 0 : decimals);

// One worked example: everything shown is computed by the calc library.
function solve(side: Side, entry: number, stop: number) {
  const r = maxLeverage({ side, entryPrice: entry, stopPrice: stop, mmr, maxLeverage: cap });
  if (!r.ok || !r.feasible || r.cappedByExchange) throw new Error('Worked example is invalid');
  const next = r.maxWholeLeverage + 1;
  const above = liquidationPrice({ side, entryPrice: entry, leverage: next, mmr, maxLeverage: next });
  if (!above.ok) throw new Error('Worked example is invalid');
  return { side, entry, stop, r, next, liqNext: above.liquidationPrice };
}

function example(title: string, s: ReturnType<typeof solve>) {
  const pct = formatPercent(s.r.stopDistance);
  const vars = {
    entry: formatNumber(s.entry),
    stop: typed(s.stop),
    mmr: mmrPct,
    m: mmrPct,
    d: pct,
    pct,
    limit: s.r.limit.toFixed(2),
    lev: s.r.maxWholeLeverage,
    next: s.next,
    liq: price(s.r.liquidationPrice),
    liqNext: price(s.liqNext),
  };
  return {
    title: fmt(title, vars),
    setup: fmt(s.side === 'long' ? t.examples.setupLong : t.examples.setupShort, vars),
    working: [t.examples.workDistance, t.examples.workLimit, t.examples.workAt].map((line) => fmt(line, vars)).join('\n'),
    result: fmt(s.side === 'long' ? t.examples.resultLong : t.examples.resultShort, vars),
  };
}

// Example 1 is also the starting state, and what a reader without JavaScript sees.
const first = solve('long', 68000, 64600);
const second = solve('short', 68000, 69360);
const ex1 = example(t.examples.first, first);
const ex2 = example(t.examples.second, second);

const start = first.r;
const startStopPct = formatPercent(start.stopDistance);
const startLiqPct = formatPercent(start.liquidationDistance);
const startLev = start.maxWholeLeverage;

const termVars = { mmr: mmrPct, limit, date };
const mistakeVars = {
  pct: startStopPct,
  naive: (1 / start.stopDistance).toFixed(0),
  mmr: mmrPct,
  limit: start.limit.toFixed(2),
};

// Plain data for the browser script.
const calcData = JSON.stringify({ tick, maxLeverage: cap, strings: t.ui });

const liquidationTool = getTool(locale, 'liquidation-price-calculator');
const positionTool = getTool(locale, 'position-size-calculator');

const jsonLd = [
  softwareApplicationLd(locale, { path: PATH, name: t.title, description: t.description }),
  breadcrumbLd(locale, [
    { name: c.breadcrumb.home, path: '/' },
    { name: c.nav.tools, path: '/tools/' },
    { name: t.title, path: PATH },
  ]),
];
---

<Base locale={locale} path={PATH} title={t.title} description={t.description} surface="measure" jsonLd={jsonLd}>
  <section class="measure" data-calc={calcData}>
    <div class="wrap">
      <h1 class="head">{t.title}</h1>
      <p class="sub">{t.lede}</p>

      <div class="sticky-scale">
        <Lanes
          id="calc-scale"
          top={start.stopDistance}
          bottom={start.liquidationDistance}
          label={fmt(t.ui.barLabel, { stop: startStopPct, lev: startLev, liq: startLiqPct })}
          topText={fmt(t.ui.stopLane, { pct: startStopPct })}
          bottomText={fmt(t.ui.liqLane, { lev: startLev, pct: startLiqPct })}
          endText={fmt(t.ui.entry, { price: formatNumber(first.entry) })}
        />
      </div>

      <form class="fields" id="calc-form" novalidate>
        <Segmented
          name="side"
          label={t.fields.side}
          value={first.side}
          options={[
            { value: 'long', label: t.fields.long },
            { value: 'short', label: t.fields.short },
          ]}
        />
        <Field id="entry" label={t.fields.entry} unit="USDT" value={first.entry} />
        <Field id="stop" label={t.fields.stop} unit="USDT" value={first.stop} />
        <Field
          id="mmr"
          label={t.fields.mmr}
          unit="%"
          value={Number((mmr * 100).toFixed(4))}
          hint={fmt(t.fields.mmrHint, { limit, date })}
        />
      </form>
      <noscript><p class="fine">{fmt(t.noscript, { pct: startStopPct })}</p></noscript>
    </div>
  </section>

  <Verdict
    label={t.result.label}
    figure={fmt(t.ui.figure, { lev: startLev })}
    sentence={fmt(t.ui.ok, { lev: startLev, stop: typed(first.stop), liq: price(start.liquidationPrice) })}
    figureId="calc-figure"
    sentenceId="calc-sentence"
  >
    <p class="fine" id="calc-note">
      {fmt(t.ui.limit, { stop: startStopPct, mmr: mmrPct, limit: start.limit.toFixed(2) })}
    </p>
    <Cta
      locale={locale}
      pageType="tool"
      position="result"
      primary={{ label: c.cta.testnet, exit: 'bybit-testnet' }}
      secondary={{ label: c.cta.liveAccount, exit: 'bybit' }}
    />
  </Verdict>

  <section class="read">
    <div class="wrap docs">
      <nav class="toc" aria-label={t.title}>
        <a class="lnk" href="#how-it-is-calculated">{t.toc.formula}</a>
        <a class="lnk" href="#worked-examples">{t.toc.examples}</a>
        <a class="lnk" href="#common-mistakes">{t.toc.mistakes}</a>
        {liquidationTool.href && <a class="lnk" href={liquidationTool.href}>{liquidationTool.name}</a>}
        {positionTool.href && <a class="lnk" href={positionTool.href}>{positionTool.name}</a>}
        <a class="lnk" href={localePath(locale, '/tools/')}>{t.allTools}</a>
      </nav>

      <div class="prose">
        <h2 id="how-it-is-calculated">{t.toc.formula}</h2>
        <p>{t.formula.intro}</p>
        <pre>{t.formula.distance + '\n' + t.formula.limit}</pre>
        <ul>
          {
            t.formula.terms.map((item) => (
              <li><strong>{item.term}</strong>{locale === 'en' ? ': ' : '：'}{fmt(item.text, termVars)}</li>
            ))
          }
        </ul>
        <p>{t.formula.why}</p>
        <p>{fmt(t.formula.whole, { max: cap })}</p>
        <p>{t.formula.leftOut}</p>

        <h2 id="worked-examples">{t.toc.examples}</h2>
        {
          [ex1, ex2].map((ex) => (
            <>
              <h3>{ex.title}</h3>
              <p>{ex.setup}</p>
              <pre>{ex.working}</pre>
              <p>{ex.result}</p>
            </>
          ))
        }

        <h2 id="common-mistakes">{t.toc.mistakes}</h2>
        {
          t.mistakes.map((m) => (
            <>
              <h3>{m.title}</h3>
              <p>{fmt(m.text, mistakeVars)}</p>
            </>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    import '../../../../scripts/leverage-calculator.ts';
  </script>
</Base>
