---
// Home. One file serves /, /zh-hant/ and /zh-hans/.
//
// Eight bands, one job each: the hero with the liquidation risk simulator,
// five facts about the site, the calculators, why a loss and its recovery
// differ, the backtests, the daily reports, the lessons, and how the site
// works. Each band is a component in src/components/home/; the footer comes
// from the layout. The <title>, description, JSON-LD, canonical and hreflang
// are the same as before the redesign.
import DrawdownDemo from '../../components/home/DrawdownDemo.astro';
import HeroSimulator from '../../components/home/HeroSimulator.astro';
import HomeTools from '../../components/home/HomeTools.astro';
import LearnList from '../../components/home/LearnList.astro';
import MarketReports from '../../components/home/MarketReports.astro';
import ResearchPreview from '../../components/home/ResearchPreview.astro';
import Transparency from '../../components/home/Transparency.astro';
import TrustStrip from '../../components/home/TrustStrip.astro';
import Button from '../../components/ui/Button.astro';
import PageContainer from '../../components/ui/PageContainer.astro';
import { localePath, localeStaticPaths } from '../../i18n/config';
import type { Locale } from '../../i18n/config';
import { home } from '../../i18n/home';
import Base from '../../layouts/Base.astro';
import { pageExists } from '../../lib/routes';
import { webSiteLd } from '../../lib/seo';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = home[locale];
---

<Base locale={locale} path="/" title={t.title} bareTitle description={t.description} jsonLd={webSiteLd(locale, t.description)}>
  <section class="section lead hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        {/* The one eyebrow on the site: the owner's spec writes this line out. */}
        <p class="hero-eyebrow" lang="en">{t.hero.eyebrow}</p>
        <h1 class="h-hero">{t.hero.head}</h1>
        <p class="lede">{t.hero.lede}</p>
        <div class="acts hero-acts">
          <Button href={localePath(locale, '/tools/')} data-cta="home:hero" data-cta-action="primary">
            {t.hero.primary}
          </Button>
          {
            pageExists('/backtests/') && (
              <Button
                variant="secondary"
                href={localePath(locale, '/backtests/')}
                data-cta="home:hero"
                data-cta-action="secondary"
              >
                {t.hero.secondary}
              </Button>
            )
          }
        </div>
      </div>
      <HeroSimulator locale={locale} />
    </div>
  </section>

  <TrustStrip locale={locale} />

  <PageContainer>
    <HomeTools locale={locale} />
  </PageContainer>

  <PageContainer band aria-labelledby="recover-head">
    <DrawdownDemo locale={locale} />
  </PageContainer>

  <PageContainer aria-labelledby="research-head">
    <ResearchPreview locale={locale} />
  </PageContainer>

  <PageContainer flush>
    <MarketReports locale={locale} />
  </PageContainer>

  <PageContainer flush>
    <LearnList locale={locale} />
  </PageContainer>

  <PageContainer band aria-labelledby="open-head">
    <Transparency locale={locale} />
  </PageContainer>

  <script>
    import '../../scripts/home-hero.ts';
    import '../../scripts/home-drawdown.ts';
  </script>

  <style>
    /* The five facts under the hero belong to it: less room between the two. */
    .section.hero {
      padding-bottom: var(--space-12);
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-10);
      align-items: center;
    }

    /* A container, so the headline can be sized against its own column. */
    .hero-copy {
      min-width: 0;
      container-type: inline-size;
    }

    .hero-eyebrow {
      margin-bottom: var(--space-4);
      color: var(--color-text-muted);
      font-size: var(--text-xs);
      font-weight: var(--weight-medium);
      letter-spacing: 0.08em;
    }

    /* The Chinese headline is two clauses of six and eight characters. It
       breaks at the comma, and the size is capped so that the longer clause
       always fits its column on one line. */
    .hero-copy .h-hero {
      font-size: min(var(--text-hero), 11.6cqi);
      word-break: keep-all;
    }

    .hero-acts {
      margin-top: var(--space-8);
    }

    @media (min-width: 1024px) {
      .hero-grid {
        grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
      }
    }

    @media (min-width: 1200px) {
      .hero-grid {
        gap: var(--space-16);
      }
    }

    /* A phone: the two actions share the row when they fit, else each takes one. */
    @media (max-width: 520px) {
      .hero-acts :global(.btn) {
        flex: 1 1 auto;
      }
    }
  </style>
</Base>
