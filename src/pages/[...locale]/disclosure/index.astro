---
// /disclosure/: how the site earns money. Linked from the footer and from the
// line under every affiliate action. The text is printed exactly as it stands
// in src/i18n/pages.ts; which of the two versions follows AFFILIATE_ACTIVE.
import DocRow from '../../../components/article/DocRow.astro';
import PageContainer from '../../../components/ui/PageContainer.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import { common } from '../../../i18n/common';
import { localeStaticPaths } from '../../../i18n/config';
import type { Locale } from '../../../i18n/config';
import { pages } from '../../../i18n/pages';
import Base from '../../../layouts/Base.astro';
import { AFFILIATE_ACTIVE } from '../../../../site.config.mjs';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = AFFILIATE_ACTIVE ? pages[locale].disclosure : pages[locale].disclosurePlain;

const trail = [
  { name: common[locale].breadcrumb.home, path: '/' },
  { name: t.title, path: '/disclosure/' },
];
---

<Base locale={locale} path="/disclosure/" title={t.title} description={t.description}>
  <PageContainer lead>
    <PageHeader locale={locale} title={t.head} lede={t.lead} breadcrumb={trail} />
    <div class="doc-rows">
      {
        t.sections.map((section) => (
          <DocRow title={section.title}>
            {section.body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </DocRow>
        ))
      }
    </div>
  </PageContainer>
</Base>

<style>
  .doc-rows {
    margin-top: var(--space-12);
  }
</style>
