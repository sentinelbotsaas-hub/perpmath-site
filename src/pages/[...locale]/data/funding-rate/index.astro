---
// /data/funding-rate/: last settlement, 7-day average and what it costs a
// long, for the three contracts, plus 30 days of daily sums as bars and as a
// table.
import ContractTable from '../../../../components/market/ContractTable.astro';
import Panels from '../../../../components/market/Panels.astro';
import SeriesChart from '../../../../components/market/SeriesChart.astro';
import { extremes, tightAxis } from '../../../../components/market/chart';
import { isStale } from '../../../../components/market/freshness';
import ChartContainer from '../../../../components/ui/ChartContainer.astro';
import DataFreshness from '../../../../components/ui/DataFreshness.astro';
import DataTable from '../../../../components/ui/DataTable.astro';
import MetricCard from '../../../../components/ui/MetricCard.astro';
import { localeStaticPaths } from '../../../../i18n/config';
import type { Locale } from '../../../../i18n/config';
import { daily } from '../../../../i18n/daily';
import { data } from '../../../../i18n/data';
import { depthShare, signTone } from '../../../../components/market/format';
import { fmt, formatNumber } from '../../../../lib/fmt';
import { latestReports } from '../../../../lib/market/store';
import { plainNumber, ratePercent } from '../../../../lib/market/view';
import DataShell from '../_DataShell.astro';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = data[locale];
const p = t.funding;
const entries = latestReports();
const first = entries[0].report;
const notional = formatNumber(first.funding.notional);
const usdt = (value: number) => fmt(p.usdt, { value: plainNumber(value) });
const latestCell = (report: (typeof entries)[number]['report']) =>
  fmt(p.latestCell, { rate: ratePercent(report.funding.latest.rate), time: report.funding.latest.time.slice(11, 16) });

const rows = entries.map(({ coin, symbol, report }) => ({
  coin,
  symbol,
  // Signed figures: the colour follows the sign that is printed.
  cells: [
    { text: latestCell(report), tone: signTone(report.funding.latest.rate) },
    { text: ratePercent(report.funding.average7d), tone: signTone(report.funding.average7d) },
    { text: usdt(report.funding.costPerDay), tone: signTone(report.funding.costPerDay) },
    { text: usdt(report.funding.costPer30Days), tone: signTone(report.funding.costPer30Days) },
  ],
}));

// 30 days, newest first, one column per contract.
const dates = first.history.funding.map((d) => d.date).reverse();
const sumOn = (index: number, date: string) => entries[index].report.history.funding.find((d) => d.date === date)?.sum;
// Depth bars in the 30-day table: one scale for the three contracts, the largest daily sum in either direction.
const largestSum = Math.max(0, ...entries.flatMap((e) => e.report.history.funding.map((d) => Math.abs(d.sum))));

// The charts: the same 30 daily sums, oldest first, in percent, on one axis.
const series = entries.map(({ symbol, report }) => ({ symbol, report, days: report.history.funding }));
const sums = series.flatMap((s) => s.days.map((d) => d.sum * 100));
const axis = tightAxis(Math.min(0, ...sums), Math.max(0, ...sums), 6);
const tick = (value: number) => `${plainNumber(value, axis.decimals)}%`;

const vars = { date: first.reportDate, notional, hours: first.instrument.fundingIntervalHours };
---

<DataShell
  locale={locale}
  slug="funding-rate"
  title={p.title}
  description={p.description}
  sub={p.sub}
  metricHead={fmt(p.metricHead, { notional })}
  chartDesc={p.chartDesc}
  definition={fmt(p.definition, vars)}
  how={p.how.map((line) => fmt(line, vars))}
  read={p.read}
  reports={entries.map((e) => e.report)}
  live="funding"
>
  <Fragment slot="metrics">
    {
      entries.map(({ coin, symbol, report }) => (
        <MetricCard
          label={`${daily[locale].coins[coin]} ${symbol}`}
          value={plainNumber(report.funding.costPerDay)}
          unit="USDT"
          valueTone={signTone(report.funding.costPerDay)}
          note={fmt(p.metricNote, { average: ratePercent(report.funding.average7d), latest: ratePercent(report.funding.latest.rate) })}
        />
      ))
    }
  </Fragment>

  <ContractTable
    slot="now"
    locale={locale}
    label={fmt(t.common.dayTable, { name: t.names['funding-rate'].name })}
    contractLabel={t.common.contract}
    columns={[p.columns.latest, p.columns.average, p.columns.perDay, p.columns.per30]}
    rows={rows}
    note={fmt(p.caption, { notional })}
  />

  <Panels slot="chart">
    {
      series.map(({ symbol, report, days }) => {
        const values = days.map((d) => d.sum * 100);
        const at = extremes(values);
        return (
          <ChartContainer
            locale={locale}
            framed
            title={symbol}
            desc={fmt(t.common.extremes, {
              days: days.length,
              max: ratePercent(days[at.max].sum),
              maxDate: days[at.max].date,
              min: ratePercent(days[at.min].sum),
              minDate: days[at.min].date,
            })}
          >
            <SeriesChart
              kind="bars"
              signed
              values={values}
              titles={days.map((d) => fmt(t.common.point, { date: d.date, value: ratePercent(d.sum) }))}
              axis={axis}
              tick={tick}
              yCaption={p.axisValue}
              xCaption={t.common.axisDate}
              first={days[0].date}
              last={days[days.length - 1].date}
              label={fmt(p.chartAlt, { symbol, from: days[0].date, to: days[days.length - 1].date })}
            />
            <DataFreshness
              slot="footer"
              locale={locale}
              date={report.reportDate}
              dateLabel={fmt(t.common.day, { date: report.reportDate })}
              source={t.common.sourceName}
              stale={isStale(report.reportDate, Date.now())}
            />
          </ChartContainer>
        );
      })
    }
  </Panels>

  <DataTable
    slot="history"
    locale={locale}
    label={fmt(t.common.historyTable, { name: t.names['funding-rate'].name })}
    caption={p.historyCaption}
    stickyFirst
    hint
    depth
    firstWidth="27%"
    minWidth="21.25rem"
  >
    <thead>
      <tr>
        <th scope="col">{t.common.date}</th>
        {entries.map(({ symbol }) => <th scope="col">{symbol}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        dates.map((date) => (
          <tr>
            <th scope="row" class="num">{date}</th>
            {entries.map((_, i) => {
              const sum = sumOn(i, date);
              if (sum === undefined) return <td class="num" />;
              return (
                <td class="num" data-depth data-tone={signTone(sum)} style={`--depth:${depthShare(sum, largestSum)}`}>
                  {ratePercent(sum)}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </DataTable>
</DataShell>
