---
// A table with one row per contract (BTCUSDT, ETHUSDT, SOLUSDT): the coin
// name links to its daily report, the other cells are figures.
// The underscore keeps this file out of the router.
//
//   <ContractTable locale={locale} contractLabel="Contract"
//     columns={['Open', 'Close']}
//     rows={[{ coin: 'btc', symbol: 'BTCUSDT', cells: ['64,850.7', '64,919.9'] }]}
//     note="Measured from the 00:00 UTC open." liveLabel="Now" />
//
// On a phone a wide table would push most columns off screen, so each row
// becomes a block there: the contract, then one line per figure with its
// column label in front. The labels are in the HTML and only shown on small
// screens; the header row is only shown on large ones.
//
// `liveLabel` adds a hidden last column that src/scripts/market-live.ts fills
// (data-live-head, data-live-cell, data-live-value).
import { localePath } from '../../../i18n/config';
import type { Locale } from '../../../i18n/config';
import { daily } from '../../../i18n/daily';
import type { Coin } from '../../../lib/market/view';

interface Props {
  locale: Locale;
  /** Header of the first column. */
  contractLabel: string;
  /** Headers of the figure columns, in order. */
  columns: string[];
  rows: Array<{ coin: Coin; symbol: string; cells: string[] }>;
  /** One line under the table: units, sign convention, timestamp. */
  note?: string;
  liveLabel?: string;
}

const { locale, contractLabel, columns, rows, note, liveLabel } = Astro.props;
---

<div class="tw">
  <table>
    <thead>
      <tr>
        <th scope="col">{contractLabel}</th>
        {columns.map((column) => <th scope="col">{column}</th>)}
        {liveLabel && <th scope="col" data-live-head hidden>{liveLabel}</th>}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <th scope="row">
              <a class="lnk" href={localePath(locale, `/daily/${row.coin}/`)}>
                {daily[locale].coins[row.coin]}
              </a>
              <span class="num symbol">{row.symbol}</span>
            </th>
            {row.cells.map((cell, i) => (
              <td>
                <span class="label">{columns[i]}</span>
                <span class="num">{cell}</span>
              </td>
            ))}
            {liveLabel && (
              <td data-live-cell={row.symbol} hidden>
                <span class="label">{liveLabel}</span>
                <span class="num" data-live-value />
              </td>
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
{note && <p class="fine">{note}</p>}

<style>
  .tw {
    margin-top: var(--space-lg);
  }

  tbody th {
    font-weight: 400;
  }

  tbody .lnk {
    font-size: var(--text-lg);
    font-weight: 800;
  }

  .symbol {
    display: block;
  }

  td {
    white-space: nowrap;
  }

  /* Column labels inside the cells: for the stacked layout only. */
  .label {
    display: none;
  }

  @media (max-width: 760px) {
    table,
    tbody,
    tr {
      display: block;
    }

    thead {
      display: none;
    }

    tr {
      padding-block: var(--space-sm);
      border-bottom: var(--hairline) solid var(--color-muted);
    }

    tbody th,
    td {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: baseline;
      gap: 0 var(--space-md);
      padding: var(--space-2xs) 0;
      border-bottom: 0;
      white-space: normal;
    }

    .symbol {
      display: inline;
    }

    .label {
      display: inline;
    }
  }
</style>
