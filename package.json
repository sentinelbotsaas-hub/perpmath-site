{
  "name": "perpmath",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "perpmath.com: calculators and plain-language lessons for crypto perpetual futures, in English, Traditional Chinese and Simplified Chinese.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "predev": "node scripts/gen-zh-hans.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/gen-zh-hans.mjs",
    "build": "astro build",
    "postbuild": "node scripts/unreleased-links.mjs && node scripts/subset-cjk.mjs --check --warn",
    "fonts:cjk": "node scripts/subset-cjk.mjs",
    "fonts:check": "node scripts/subset-cjk.mjs --check",
    "preview": "astro preview",
    "test": "vitest run",
    "check:dist": "node scripts/check-dist.mjs",
    "gen:zh-hans": "node scripts/gen-zh-hans.mjs",
    "gen:vercel": "node scripts/gen-vercel.mjs",
    "fetch:risk-limit": "node scripts/fetch-risk-limit.mjs",
    "fetch:market": "node scripts/fetch-market.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "astro": "^7.4.12",
    "opencc-js": "^1.4.2"
  },
  "devDependencies": {
    "vitest": "^5.1.1"
  }
}
